[
  {
    "tool": "find_functions",
    "args": {
      "program": "tiny-glade.exe",
      "query": "resources::rt",
      "limit": 100
    },
    "timeout_seconds": 120
  },
  {
    "tool": "get_functions",
    "args": {
      "program": "tiny-glade.exe",
      "functions": "0x1408bcff0,0x140b0da50,0x140b24d50",
      "fields": "signature,decompiled_code,callees",
      "include_call_context": false
    },
    "timeout_seconds": 300
  }
]

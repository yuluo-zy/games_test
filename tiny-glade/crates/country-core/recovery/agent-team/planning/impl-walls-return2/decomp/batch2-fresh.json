[
  {
    "tool": "find_functions",
    "args": {
      "program": "tiny-glade.exe",
      "search": "closest_segment_to_snap_to",
      "limit": 10
    },
    "timeout_seconds": 120
  },
  {
    "tool": "get_functions",
    "args": {
      "program": "tiny-glade.exe",
      "functions": "0x1412fba80",
      "fields": "signature,decompiled_code,callees",
      "include_call_context": false
    },
    "timeout_seconds": 300
  }
]

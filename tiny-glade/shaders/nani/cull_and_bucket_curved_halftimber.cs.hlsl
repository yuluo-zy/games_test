            uint bucket_lo;
            if (any(bool2(sample_xy.x >= two_minus_lod_radius.x, sample_xy.y >= two_minus_lod_radius.y)) ? all(bool2(sample_xy.x <= seven_plus_lod_radius.x, sample_xy.y <= seven_plus_lod_radius.y)) : false)

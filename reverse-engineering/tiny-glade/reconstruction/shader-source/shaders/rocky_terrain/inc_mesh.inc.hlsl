// ==RECONSTRUCTED== shaders/rocky_terrain/inc_mesh.inc.hlsl | F-R | include-only (embedded in _rocky_terrain_displace_rocky_terrain.cs.hlsl_cs_main_0.bin, _rocky_terrain_rocky_terrain.raster.hlsl_b903e43ffb3da915.bin, _rocky_terrain_rocky_terrain.raster.hlsl_f0adff76827e73ff.bin)
// Shared rocky-terrain mesh record layouts. The displaced mesh is generated by
// displace_rocky_terrain.cs (one thread per triangle) and consumed by the
// rocky_terrain.raster pass (and the stairs pass) through two SSBOs:
//   vertices  - 48-byte per-vertex record (offsets: rest_position 0,
//               cell_bby 12, position 16, cell_id 28, dir_to_centroid 32,
//               is_corner 44)
//   triangles - 32-byte per-triangle record (offsets: neighbours 0, is_top 12,
//               normal 16, pad1 28)
// evidence: spirv-cross + raw SPIR-V member offsets (OpMemberDecorate Offset) of
//   _rocky_terrain_rocky_terrain.raster.hlsl_b903e43ffb3da915.bin vs/ps and the
//   displace_rocky_terrain CS: the VS loads position at byte 16 (so cell_bby is a
//   single float at 12, NOT a float3) and the CS stores cell_id at 28 /
//   is_corner at 44; triangles.stride is 32 with neighbours int3 at 0,
//   is_top int at 12, normal float3 at 16, pad1 float at 28.
// status: O (member order/types/offsets verbatim from .cross + SPV decorations).

#ifndef TINYGLADE_ROCKY_TERRAIN_INC_MESH_HLSL
#define TINYGLADE_ROCKY_TERRAIN_INC_MESH_HLSL

// One vertex of the displaced rocky-terrain mesh. 48 bytes.
struct Vertex
{
    float3 rest_position;
    float cell_bby;
    float3 position;
    int cell_id;
    float3 dir_to_centroid;
    int is_corner;
};

// One triangle of the displaced mesh. `neighbours[i]` is the index of the
// triangle sharing edge i (the edge opposite corner i), -1 on a boundary.
// 32 bytes.
struct Triangle
{
    int3 neighbours;
    int is_top;
    float3 normal;
    float pad1;
};

#endif // TINYGLADE_ROCKY_TERRAIN_INC_MESH_HLSL

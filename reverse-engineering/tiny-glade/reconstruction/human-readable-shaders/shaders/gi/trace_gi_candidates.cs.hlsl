            uint bit_y = uint((y_idx & bit) > 0u);
            next_morton = morton + ((bit * bit) * ((3u * bit_x) ^ bit_y));
            if (bit_y == 0u)
            {
                uint flip_y;
                uint flip_x;
                if (bit_x == 1u)
                {
                    flip_y = 63u - y_idx;
                    flip_x = 63u - x_idx;
                }
                else
                {
                    flip_y = y_idx;
                    flip_x = x_idx;
                }
                next_y = flip_x;
                next_x = flip_y;
            }
            else
            {
                next_y = y_idx;
                next_x = x_idx;
            }
        }
        uint frame_phase = frame_constants_frame_index % 64u;
        float2 rand01 = frac((float2(0.75487768650054931640625f, 0.56984031200408935546875f) * float(morton + (288u * frame_phase))) + 0.5f.xx);
        float normal_z = normal_world.z;
        float3 tangent;
        float3 bitangent;
        if (normal_z < 0.0f)
        {
            float inv_w_neg = 1.0f / (1.0f - normal_z);
            float nx0 = normal_world.x;
            float ny0 = normal_world.y;
            float nxy0 = (nx0 * ny0) * inv_w_neg;
            tangent = float3(nxy0, ((ny0 * ny0) * inv_w_neg) - 1.0f, -ny0);
            bitangent = float3(1.0f - ((nx0 * nx0) * inv_w_neg), -nxy0, nx0);

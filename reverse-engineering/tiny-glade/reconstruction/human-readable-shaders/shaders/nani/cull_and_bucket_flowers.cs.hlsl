            uint cam2_lod_index = clamp(uint((cam2_clip_pos.xyz / cam2_clip_pos.w.xxx).z * 1024.0f), 0u, 1023u);
            uint cam2_instance_index = instance_base + cam2_lod_index;
            float lod_radius = world_radius * (2.0f * frame_constants_view_constants[2u].view_to_sample[0].x);
            float2 sample_xy = abs(mul(frame_constants_view_constants[2u].world_to_sample, world_pos).xy);
            float2 neg_lod_radius = (-lod_radius).xx;
            float2 one_plus_lod_radius = (1.0f + lod_radius).xx;
            uint bucket_sel0 = (any(bool2(sample_xy.x >= neg_lod_radius.x, sample_xy.y >= neg_lod_radius.y)) ? all(bool2(sample_xy.x <= one_plus_lod_radius.x, sample_xy.y <= one_plus_lod_radius.y)) : false) ? 0u : 3u;
            float2 one_minus_lod_radius = (1.0f - lod_radius).xx;
            float2 two_plus_lod_radius = (2.0f + lod_radius).xx;
            bool in_ring1 = any(bool2(sample_xy.x >= one_minus_lod_radius.x, sample_xy.y >= one_minus_lod_radius.y)) ? all(bool2(sample_xy.x <= two_plus_lod_radius.x, sample_xy.y <= two_plus_lod_radius.y)) : false;
            uint bucket_sel;
            if (in_ring1)
            {
                bucket_sel = min(bucket_sel0, 1u);
            }
            else
            {
                bucket_sel = bucket_sel0;
            }
            uint in_ring1_u = uint(in_ring1);
            float2 two_minus_lod_radius = (2.0f - lod_radius).xx;
            float2 seven_plus_lod_radius = (7.0f + lod_radius).xx;
            uint bucket_hi;
            uint bucket_lo;
            if (any(bool2(sample_xy.x >= two_minus_lod_radius.x, sample_xy.y >= two_minus_lod_radius.y)) ? all(bool2(sample_xy.x <= seven_plus_lod_radius.x, sample_xy.y <= seven_plus_lod_radius.y)) : false)
            {
                bucket_hi = max(in_ring1_u, 2u);
                bucket_lo = min(bucket_sel, 2u);
            }
            else
            {
                bucket_hi = in_ring1_u;
                bucket_lo = bucket_sel;
            }
            for (uint bucket = bucket_lo; bucket <= bucket_hi; )
            {
                uint slot;
                __alias_filtered_instance_allocator_buffer.InterlockedAdd(((push_constants.draw_list_index_base + 1u) + bucket) * 4 + 0, 1u, slot);
                __alias_filtered_instance_buffer.Store<uint>(slot * 4 + 0, cam2_instance_index);
                GpuFilteredInstanceMeta meta = { mesh_id };
                __alias_filtered_instance_meta_buffer.Store<uint>(slot * 4 + 0, meta.raw);
                uint hist_dummy;
                __alias_output_histogram.InterlockedAdd(((((push_constants.draw_list_index_base + 1u) + bucket) * 1024u) + cam2_lod_index) * 4 + 0, 1u, hist_dummy);
                bucket++;
                continue;
            }
        }
        break;
    } while(false);
}


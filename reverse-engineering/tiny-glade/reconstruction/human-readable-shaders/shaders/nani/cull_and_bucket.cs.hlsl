        // 依次用四个角平面测试包围球是否在视锥内。
        for (int i = 0; i < 4; inside = inside_next, i++)
        {
            if (inside)
            {
                inside_next = dot(float4(view_pos.xy, view_z, 1.0f), frustum_planes[i]) > (-sphere_radius);
            }
            else
            {
                inside_next = false;
            }
        }
        // 全局实例索引 = 线程号 + 绘制列表的实例偏移基址。
        uint global_instance_index = gl_GlobalInvocationID.x + draw_list_info.Load<uint>(push_constants.draw_list_index_base * 4 + 0);
        // 上一帧可见性:若上一帧已可见,则只保留在下一帧位图中(不重复追加)。
        bool prev_visible;
        if (inside)
        {
            prev_visible = (prev_visibility_bitmask.Load<uint>((global_instance_index / 32u) * 4 + 0) & (1u << ((global_instance_index % 32u) & 31u))) != 0u;
        }
        else
        {
            prev_visible = false;
        }
        if (prev_visible)
        {
            // 保持可见:写入下一帧可见性位图,并追加进过滤实例列表 + 累加直方图。
            uint prev_bit;
            __alias_next_visibility_bitmask.InterlockedOr((global_instance_index / 32u) * 4 + 0, 1u << ((global_instance_index % 32u) & 31u), prev_bit);
            uint alloc_idx;
            __alias_filtered_instance_allocator_buffer.InterlockedAdd(push_constants.draw_list_index_base * 4 + 0, 1u, alloc_idx);
            __alias_filtered_instance_buffer.Store<uint>(alloc_idx * 4 + 0, instance_base_offset + lod_bucket);
            GpuFilteredInstanceMeta meta = { mesh_part_index };
            __alias_filtered_instance_meta_buffer.Store<uint>(alloc_idx * 4 + 0, meta.raw);
            uint ignore_hist;
            __alias_output_histogram.InterlockedAdd(((push_constants.draw_list_index_base * 1024u) + lod_bucket) * 4 + 0, 1u, ignore_hist);
        }
        // 第二相机(缩略图/副视口)的 LOD 桶级联:按屏幕投影尺寸归入不同桶。
        if ((((sphere_radius / max(9.9999997473787516355514526367188e-06f, -view_z)) * ((0.5f * view_to_clip0[1u].y) * float(clamp(frame_constants_inner_rendering_resolution.y, 1080u, 2160u)))) < 10.0f) ? false : true)
        {
            float4 camera2_clip = mul(frame_constants_view_constants[2u].view_to_clip, mul(frame_constants_view_constants[2u].world_to_view, world_pos));
            float4 camera2_pos = camera2_clip;
            uint lod_bucket2 = clamp(uint((camera2_clip.xyz / camera2_pos.w.xxx).z * 1024.0f), 0u, 1023u);
            uint global_index2 = instance_base_offset + lod_bucket2;
            // 投影半径(像素单位):包围球半径在第二相机下的覆盖宽度。
            float proj_radius = sphere_radius * (2.0f * frame_constants_view_constants[2u].view_to_sample[0].x);
            float2 sample_xy = abs(mul(frame_constants_view_constants[2u].world_to_sample, world_pos).xy);
            // 用投影半径划分屏幕空间区域,把实例追加到对应的 LOD 级联桶。
            float2 neg_radius = (-proj_radius).xx;
            float2 one_plus_radius = (1.0f + proj_radius).xx;
            uint region0 = (any(bool2(sample_xy.x >= neg_radius.x, sample_xy.y >= neg_radius.y)) ? all(bool2(sample_xy.x <= one_plus_radius.x, sample_xy.y <= one_plus_radius.y)) : false) ? 0u : 3u;
            float2 one_minus_radius = (1.0f - proj_radius).xx;
            float2 two_plus_radius = (2.0f + proj_radius).xx;
            bool region1 = any(bool2(sample_xy.x >= one_minus_radius.x, sample_xy.y >= one_minus_radius.y)) ? all(bool2(sample_xy.x <= two_plus_radius.x, sample_xy.y <= two_plus_radius.y)) : false;
            uint region1_min;
            if (region1)
            {
                region1_min = min(region0, 1u);
            }
            else
            {
                region1_min = region0;
            }
            uint region1_uint = uint(region1);
            float2 two_minus_radius = (2.0f - proj_radius).xx;
            float2 seven_plus_radius = (7.0f + proj_radius).xx;
            uint region_max;
            uint region_min;
            if (any(bool2(sample_xy.x >= two_minus_radius.x, sample_xy.y >= two_minus_radius.y)) ? all(bool2(sample_xy.x <= seven_plus_radius.x, sample_xy.y <= seven_plus_radius.y)) : false)
            {
                region_max = max(region1_uint, 2u);
                region_min = min(region1_min, 2u);
            }
            else
            {
                region_max = region1_uint;
                region_min = region1_min;
            }
            // 遍历该实例所属的级联桶区间,追加实例并累加各桶直方图。
            for (uint bucket = region_min; bucket <= region_max; )
            {
                uint alloc_idx;
                __alias_filtered_instance_allocator_buffer.InterlockedAdd(((push_constants.draw_list_index_base + 1u) + bucket) * 4 + 0, 1u, alloc_idx);
                __alias_filtered_instance_buffer.Store<uint>(alloc_idx * 4 + 0, global_index2);
                GpuFilteredInstanceMeta meta = { mesh_part_index };
                __alias_filtered_instance_meta_buffer.Store<uint>(alloc_idx * 4 + 0, meta.raw);
                uint ignore_hist;
                __alias_output_histogram.InterlockedAdd(((((push_constants.draw_list_index_base + 1u) + bucket) * 1024u) + lod_bucket2) * 4 + 0, 1u, ignore_hist);
                bucket++;
                continue;
            }
        }
        break;
    } while(false);
}


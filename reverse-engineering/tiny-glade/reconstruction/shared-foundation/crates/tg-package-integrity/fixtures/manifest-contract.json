{
  "scope": "B original verify code in isolated DLL loader container, not original game process",
  "cases": [
    {
      "name": "success",
      "bytes": "{\"version\":1,\"files\":[[\"build-info/manifest.json\",\"ignored\"]]}\t\t\t\t\t\t \t\t    \t \t    ",
      "expected": {
        "kind": "ok"
      }
    },
    {
      "name": "unknown-field",
      "bytes": "{\"version\":1,\"files\":[[\"build-info/manifest.json\",\"ignored\"]],\"unknown\":{\"nested\":[null,true]}}\t\t \t\t \t \t \t\t\t\t \t    ",
      "expected": {
        "kind": "ok"
      }
    },
    {
      "name": "reordered",
      "bytes": "{\"files\":[[\"build-info/manifest.json\",\"ignored\"]],\"version\":1} \t\t\t\t \t \t\t \t\t \t     ",
      "expected": {
        "kind": "ok"
      }
    },
    {
      "name": "sequence",
      "bytes": "[1,[[\"build-info/manifest.json\",\"ignored\"]]]  \t   \t \t \t   \t\t    ",
      "expected": {
        "kind": "ok"
      }
    },
    {
      "name": "version-zero",
      "bytes": "{\"version\":0,\"files\":[]} \t\t \t    \t \t\t \t     ",
      "expected": {
        "kind": "version",
        "version": 0
      }
    },
    {
      "name": "version-two",
      "bytes": "{\"version\":2,\"files\":[]}   \t \t\t  \t  \t\t\t\t\t   ",
      "expected": {
        "kind": "version",
        "version": 2
      }
    },
    {
      "name": "version-max-u32",
      "bytes": "{\"version\":4294967295,\"files\":[]}  \t \t\t \t \t\t\t\t       ",
      "expected": {
        "kind": "version",
        "version": 4294967295
      }
    },
    {
      "name": "version-overflow",
      "bytes": "{\"version\":4294967296,\"files\":[]} \t \t\t \t\t \t\t \t  \t \t  ",
      "expected": {
        "kind": "parse",
        "message": "invalid value: integer `4294967296`, expected u32 at line 1 column 21"
      }
    },
    {
      "name": "version-negative",
      "bytes": "{\"version\":-1,\"files\":[]}\t  \t\t   \t\t\t \t \t \t   ",
      "expected": {
        "kind": "parse",
        "message": "invalid value: integer `-1`, expected u32 at line 1 column 13"
      }
    },
    {
      "name": "version-float",
      "bytes": "{\"version\":1.0,\"files\":[]}\t  \t\t\t\t \t\t  \t\t \t\t   ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: floating point `1.0`, expected u32 at line 1 column 14"
      }
    },
    {
      "name": "version-null",
      "bytes": "{\"version\":null,\"files\":[]} \t\t\t\t \t  \t\t\t \t\t\t \t  ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: null, expected u32 at line 1 column 15"
      }
    },
    {
      "name": "version-string",
      "bytes": "{\"version\":\"1\",\"files\":[]}  \t\t\t\t\t\t \t \t\t \t   \t ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: string \"1\", expected u32 at line 1 column 14"
      }
    },
    {
      "name": "duplicate-version",
      "bytes": "{\"version\":1,\"version\":1,\"files\":[]}\t  \t\t  \t\t  \t \t      ",
      "expected": {
        "kind": "parse",
        "message": "duplicate field `version` at line 1 column 22"
      }
    },
    {
      "name": "duplicate-files",
      "bytes": "{\"version\":1,\"files\":[],\"files\":[]}\t \t\t     \t\t  \t\t     ",
      "expected": {
        "kind": "parse",
        "message": "duplicate field `files` at line 1 column 31"
      }
    },
    {
      "name": "missing-version",
      "bytes": "{\"files\":[]}    \t\t       \t\t\t    ",
      "expected": {
        "kind": "parse",
        "message": "missing field `version` at line 1 column 12"
      }
    },
    {
      "name": "missing-files",
      "bytes": "{\"version\":1} \t \t\t\t \t   \t\t\t\t  \t  ",
      "expected": {
        "kind": "parse",
        "message": "missing field `files` at line 1 column 13"
      }
    },
    {
      "name": "capitalized-version",
      "bytes": "{\"Version\":1,\"files\":[]} \t\t\t \t \t\t\t\t\t    \t   ",
      "expected": {
        "kind": "parse",
        "message": "missing field `version` at line 1 column 24"
      }
    },
    {
      "name": "sequence-extra",
      "bytes": "[1,[[\"build-info/manifest.json\",\"ignored\"]],true]\t\t\t\t\t\t \t       \t  \t ",
      "expected": {
        "kind": "parse",
        "message": "trailing characters at line 1 column 45"
      }
    },
    {
      "name": "sequence-short",
      "bytes": "[1]  \t \t \t\t\t\t \t   \t    ",
      "expected": {
        "kind": "parse",
        "message": "invalid length 1, expected struct PackageManifest with 2 elements at line 1 column 3"
      }
    },
    {
      "name": "tuple-short",
      "bytes": "{\"version\":1,\"files\":[[\"a\"]]}\t\t\t\t\t\t\t\t\t\t\t\t  \t \t\t  ",
      "expected": {
        "kind": "parse",
        "message": "invalid length 1, expected a tuple of size 2 at line 1 column 27"
      }
    },
    {
      "name": "tuple-extra",
      "bytes": "{\"version\":1,\"files\":[[\"a\",\"b\",\"c\"]]}\t \t \t \t     \t\t      ",
      "expected": {
        "kind": "parse",
        "message": "trailing characters at line 1 column 32"
      }
    },
    {
      "name": "file-object",
      "bytes": "{\"version\":1,\"files\":[{\"name\":\"a\",\"hash\":\"b\"}]}    \t  \t            ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: map, expected a tuple of size 2 at line 1 column 22"
      }
    },
    {
      "name": "file-number",
      "bytes": "{\"version\":1,\"files\":[[1,\"b\"]]}\t\t\t \t \t\t\t\t\t \t\t      ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: integer `1`, expected a string at line 1 column 24"
      }
    },
    {
      "name": "hash-bool",
      "bytes": "{\"version\":1,\"files\":[[\"a\",false]]}  \t\t\t\t\t \t\t\t\t\t       ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: boolean `false`, expected a string at line 1 column 32"
      }
    },
    {
      "name": "parse-after-gate",
      "bytes": "not json \t\t  \t\t    \t        ",
      "expected": {
        "kind": "parse",
        "message": "expected ident at line 1 column 2"
      }
    },
    {
      "name": "schema-before-version",
      "bytes": "{\"version\":2,\"files\":[[1,\"b\"]]}  \t  \t\t\t\t \t\t\t \t\t    ",
      "expected": {
        "kind": "parse",
        "message": "invalid type: integer `1`, expected a string at line 1 column 24"
      }
    }
  ],

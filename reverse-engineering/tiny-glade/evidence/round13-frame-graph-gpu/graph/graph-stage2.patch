+            state.phase = painterly::PainterlyPhase::Disabled;
+            return Ok(());
+        }
+        // The native reset precedes temporal/shader/resource lookup failures.
+        if state.phase == painterly::PainterlyPhase::Disabled || instant_flag || count == Some(0) {

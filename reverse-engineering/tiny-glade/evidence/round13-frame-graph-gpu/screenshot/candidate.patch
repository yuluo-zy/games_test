+        return Err(rhapsody::Error::invalid_usage(
+            "native MetaCommander screenshot purpose must be 4",
+        ));
+    }
+    enqueue(world, request)?;
+    world
+        .resource_mut::<Requests>()
+        .active
+        .last_mut()
+        .expect("just inserted")
+        .remaining = 1;
+    Ok(())

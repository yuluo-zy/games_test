+pub fn enqueue(world: &mut World, request: ScreenshotRequest) -> rhapsody::Result<()> {
+    let mut owner = world
+        .get_resource_mut::<Requests>()
+        .ok_or_else(missing_owner)?;
+    if owner.closing {
+        return Err(rhapsody::Error::invalid_usage(
+            "screenshot owner is shutting down",

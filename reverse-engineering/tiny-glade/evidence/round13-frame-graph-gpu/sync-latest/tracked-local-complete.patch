+        let deg_a = degrees.get(&a.id).copied().unwrap_or(0);
+        let deg_b = degrees.get(&b.id).copied().unwrap_or(0);
+        if deg_a >= params.max_per_node || deg_b >= params.max_per_node {
+            continue;
+        }
+        let pair = if i < j { (i, j) } else { (j, i) };
+        if !used.insert(pair) {

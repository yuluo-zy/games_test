+        let (flags, strength) = match v.blend_mode {
+            SavedStrokeBlend::Max => (0, 0.0),
+            SavedStrokeBlend::Add { opacity } => (1, opacity),
+        };
+        Ok(Self {
+            flags,
+            strength,
+            points: Arc::from(v.points),
+            radius: v.brush_size,
+            draw: v.is_additive,
+        })
+    }
+}

+fn body_rotation(yaw: f32, pitch: f32) -> Quat {
+    let scale = super::main_camera::ORBIT_ANGLE_SCALE;
+    Quat::from_rotation_y(yaw * scale) * Quat::from_rotation_x(pitch * scale)

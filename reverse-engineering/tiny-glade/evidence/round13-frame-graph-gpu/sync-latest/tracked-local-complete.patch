+#[inline]
+fn clamped_or_nan(value: f32) -> f32 {
+    // 原 minps/maxps + NAN 处理：NaN 传播，其余 clamp 到 [-1,1]。
+    if value.is_nan() {
+        value
+    } else {
+        value.clamp(-1.0, 1.0)
+    }

+/// sag 混合因子：`clamp(sag_len / dist, 0, 0.25)`（O 行 130-137）。
+pub fn clothline_sag_fraction(sag_len: f32, dist: f32) -> f32 {
+    let f = sag_len / dist;
+    if f >= 0.0 {
+        f.min(CLOTH_MAX_SAG_FRACTION)
+    } else {

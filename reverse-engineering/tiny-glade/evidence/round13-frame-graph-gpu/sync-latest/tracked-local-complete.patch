+/// 布绳采样点数：`n = max(2, round(dist / spacing))`（O 0x1407e2510 行 115-129）。
+pub fn clothline_sample_count(dist: f32, spacing: f32) -> usize {
+    let n = (dist / spacing).round();
+    // O：`2 < n` 取 n，否则 2（NaN 比较为 false → 2）。

+/// 布绳中点下垂量：`(1 - (2t-1)²) * 0.08 * dist`（O 行 203-204）。
+pub fn cloth_sag_offset(t: f32, dist: f32) -> f32 {
+    let u = t + t - 1.0;
+    (1.0 - u * u) * CLOTH_SAG * dist

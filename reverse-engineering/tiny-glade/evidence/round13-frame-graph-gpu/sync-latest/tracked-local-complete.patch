+        }
+        let delta = b.pos - a.pos;
+        let horizontal = Vec2::new(delta.x, delta.z).length();
+        // O：`fVar55 + fVar55 <= SQRT(dx²+dz²)` → 继续（坡度门）。
+        let vertical = delta.y.abs();

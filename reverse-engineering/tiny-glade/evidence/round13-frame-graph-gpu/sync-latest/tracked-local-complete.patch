+impl CameraSnapshot {
+    /// Original advances at most one state per call, including large deltas.
+    pub fn advance(&mut self, step: f32) {
+        use CameraSnapshotInterpolation::*;
+        match self.interpolation {
+            Disabled => {}
+            Accelerating => {
+                self.elapsed += step;
+                if !(6.0 > self.elapsed) {
+                    self.interpolation = Slow;
+                    self.elapsed += -6.0;
+                }
+            }

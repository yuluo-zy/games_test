+/// 离散选择：`undo` 取 `from`，否则取 `to`（所有 target 一致）。
+#[inline]
+fn pick<T: Copy>(undo: bool, from: T, to: T) -> T {
+    if undo {
+        from
+    } else {
+        to
+    }
+}

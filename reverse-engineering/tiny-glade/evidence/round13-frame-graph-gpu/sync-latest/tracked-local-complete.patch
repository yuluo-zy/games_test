+    storage: &DecoratorStorage,
+    env: &WallMergeEnv<'_>,
+    candidate: WallIntersectCandidate,
+    excluded: &[u32],
+) -> Option<WallMergePosition> {
+    let mut best: Option<WallMergePosition> = None;

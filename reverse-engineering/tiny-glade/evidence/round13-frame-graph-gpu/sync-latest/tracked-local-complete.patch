+fn derive_one(
+    wall_state: &PublicWallState,
+    roof: Option<&Roof>,
+    mesh_lib: &DecoratorMeshLibrary,
+    info: &DecoratorInfo,
+) -> Result<DerivedDecoratorInfo, SubtypeError> {

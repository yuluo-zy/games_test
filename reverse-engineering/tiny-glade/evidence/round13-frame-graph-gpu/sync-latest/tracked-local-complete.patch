+            } else {
+                sse_min(extent, sse_max(-extent, value))
+            }
+        };
+        let clamped = Vec2::new(clamp(point.x), clamp(point.y));
+        let excess = point - clamped;
+        let squared = excess.x * excess.x + excess.y * excess.y;
+        if extent_squared < squared {

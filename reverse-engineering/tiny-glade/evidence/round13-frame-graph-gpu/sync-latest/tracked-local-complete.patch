+    fn wall_intersection(&self,p:Vec3,end:Vec2,loc:u32,require:bool)->bool {wall_intersection(self.hash,self.walls,p,end,loc,require)}
+    fn spherecast(&self,origin:Vec3,direction:Vec3,radius:f32)->Option<Vec3> {

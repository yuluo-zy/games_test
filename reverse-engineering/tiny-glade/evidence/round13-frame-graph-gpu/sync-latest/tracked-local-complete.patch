+                    super::walk::GroundSourceUpdate::NoHit => self.raw[0x328] = 0x11,
+                    super::walk::GroundSourceUpdate::Terrain => self.raw[0x328] = 0x0b,
+                    super::walk::GroundSourceUpdate::Collider(words) => {

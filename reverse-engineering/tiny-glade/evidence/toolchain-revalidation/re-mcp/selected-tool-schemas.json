    {
      "name": "wait_for_analysis",
      "title": "Wait for Analysis",
      "description": "Block until database(s) finish opening and optional auto-analysis.\n\n**Single:** pass ``database`` to wait for one DB.\n**Multi:** pass ``databases`` list \u2014 returns when **at least one**\nis ready. Work on the ready one, call again for the rest.\n\nWhile analysis runs, the backend thread is blocked \u2014 tool calls queue.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "default": "",
            "type": "string",
            "description": "Single database ID to wait for."
          },
          "databases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "List of database IDs (returns when first is ready)."
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": "Wait for Analysis",
        "readOnlyHint": null,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": null
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "execution": null
    },
    {
      "name": "open_database",
      "title": "Open Database",
      "description": "Open a binary for analysis with Ghidra.\n\nReturns immediately with ``\"opening\": true`` \u2014 call\nwait_for_analysis before using other tools on this database.\nRe-opening an already-open database returns the existing worker.\n\n**Multiple binaries:** use a separate subagent per binary.\n\n**force_new=True** is destructive: deletes existing Ghidra\nproject and all prior analysis.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file_path": {
            "type": "string",
            "description": "Path to the binary file."
          },
          "run_auto_analysis": {
            "default": false,
            "type": "boolean",
            "description": "Run Ghidra auto-analysis after opening."
          },
          "keep_open": {
            "default": true,
            "type": "boolean",
            "description": "Keep other open databases (default True)."
          },
          "database_id": {
            "default": "",
            "type": "string",
            "description": "Custom ID (must match [a-z][a-z0-9_]{0,31})."
          },
          "force_new": {
            "default": false,
            "type": "boolean",
            "description": "Delete existing project and start fresh."
          },
          "language": {
            "default": "",
            "type": "string",
            "description": "Ghidra language ID (e.g. ``x86:LE:64:default``,\n      ``ARM:LE:32:v8``). Auto-detected when omitted.\n      Use list_targets to see options."
          },
          "compiler_spec": {
            "default": "",
            "type": "string",
            "description": "Ghidra compiler spec (e.g. ``gcc``,\n           ``windows``). Auto-detected when omitted."
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": "Open Database",
        "readOnlyHint": null,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": null
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "execution": null
    },

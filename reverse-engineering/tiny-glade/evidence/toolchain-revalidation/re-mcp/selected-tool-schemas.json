    {
      "name": "search_tools",
      "title": null,
      "description": "Search hidden tools by regex (pinned tools excluded; use ``.*`` for all).\n\nReturns one-line signatures by default. Use ``detail=\"detailed\"``\nfor parameter schemas, or follow up with ``get_schema(tools=[...])``.\n\nHidden tools must be called via **call**, **batch**, or **execute**\n\u2014 direct calls will fail because they are not in the client tool list.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "description": "Regex pattern to match against tool names, descriptions, and tags",
            "type": "string"
          },
          "detail": {
            "default": "brief",
            "description": "'brief' (default) for a one-line signature + summary per tool, 'detailed' for parameter schemas as markdown, 'full' for complete JSON schemas",
            "enum": [
              "brief",
              "detailed",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "icons": null,
      "annotations": null,
      "meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "execution": null
    },
    {

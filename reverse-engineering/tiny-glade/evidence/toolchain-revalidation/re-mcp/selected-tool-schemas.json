  "tools": [
    {
      "name": "close_database",
      "title": "Close Database",
      "description": "Close a database and terminate its worker process.\n\nSpecify *database* when multiple are open. Fails if the DB is\nnot attached to the current session unless force=True. When other\nsessions still use the DB, detaches this session but keeps the\nworker alive.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "save": {
            "default": true,
            "type": "boolean"
          },
          "force": {
            "default": false,
            "type": "boolean"
          },
          "database": {
            "default": "",
            "type": "string"
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "icons": null,
      "annotations": {
        "title": "Close Database",
        "readOnlyHint": null,
        "destructiveHint": null,
        "idempotentHint": null,
        "openWorldHint": null
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "execution": null
    },

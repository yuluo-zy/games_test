+        values['program'] = PROGRAM
+        url = state['url'] + '/' + endpoint + '?' + urllib.parse.urlencode(values)
+        with opener.open(url, timeout=15) as response:
+            payload = json.load(response)
+        if not isinstance(payload, dict) or payload.get('error') or payload.get('success') is False:
+            raise RuntimeError('Database health query failed: ' + str(payload))
+        return payload
+    functions = query('get_functions', functions='0x14090e510', fields='signature',
+                      include_call_context='false')
+    entries = functions.get('functions', {})
+    if not entries.get('0x14090e510', {}).get('signature'):
+        raise RuntimeError('Database health check could not read the known B function')
+    memory = query('read_memory', address='0x140949c20', length=20)
+    expected = '8b01f3480f2ac08b4104f3480f2ac8f30f5ec1c3'
+    if memory.get('hex', '').lower() != expected:
+        raise RuntimeError('Database health check read different B instruction bytes')
+    return {'symbol_index': True, 'known_instruction_bytes': True}
 
 

diff --git a/tiny-glade/crates/country-core/src/input/recording.rs b/tiny-glade/crates/country-core/src/input/recording.rs
index 3acde0cb..c0d9a86a 100644
--- a/tiny-glade/crates/country-core/src/input/recording.rs
+++ b/tiny-glade/crates/country-core/src/input/recording.rs
@@ -123,10 +123,45 @@ pub fn save_recording(path: &Path, stream: &InputStream<InputFrame>) -> Result<(
         temporary.as_file().metadata()?.len() <= MAX_RECORDING_FILE_BYTES,
         "输入录制超过 64 MiB 限制"
     );
-    temporary
-        .persist(path)
-        .map_err(|error| error.error)
-        .context("替换输入录制文件失败")?;
+    // Windows 的 rename/persist 不能覆盖已存在目标。先把旧文件移到同目录的
+    // 唯一备份，再 persist；persist 失败则恢复备份，保持“失败保留原文件”。
+    #[cfg(windows)]
+    {
+        let backup = if path.exists() {
+            let name = path
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or("recording");
+            let backup = parent.join(format!(
+                ".{name}.{}.tg-rec-backup",
+                fastrand::u64(..)
+            ));
+            std::fs::rename(path, &backup).context("备份输入录制文件失败")?;
+            Some(backup)
+        } else {
+            None
+        };
+        match temporary.persist(path) {
+            Ok(_) => {
+                if let Some(backup) = backup {
+                    let _ = std::fs::remove_file(backup);
+                }
+            }
+            Err(error) => {
+                if let Some(backup) = backup {
+                    let _ = std::fs::rename(backup, path);
+                }
+                return Err(error.error).context("替换输入录制文件失败");
+            }
+        }
+    }
+    #[cfg(not(windows))]
+    {
+        temporary
+            .persist(path)
+            .map_err(|error| error.error)
+            .context("替换输入录制文件失败")?;
+    }
     Ok(())
 }
 

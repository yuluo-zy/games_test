+fn obsolete_simplified_wire_is_rejected_and_present_values_are_never_defaulted() {
+    let valid = serde_json::to_value(GladeColorCustomization::default()).unwrap();
+    for (field, bad) in [
+        ("flag", serde_json::json!(true)),
+        ("stairs", serde_json::json!(100003)),
+        ("building_wall_style", serde_json::json!(1)),
+        ("freehand_ty", serde_json::json!(0)),
+        ("flat_rim_style", serde_json::json!(0)),
+        ("windows", serde_json::json!(true)),
+    ] {
+        let mut invalid = valid.clone();
+        invalid[field] = bad;
+        assert!(
+            serde_json::from_value::<GladeColorCustomization>(invalid).is_err(),
+            "{field}"
+        );
+    }
+    let mut invalid = valid.clone();
+    invalid["stairs"]["railing_ty"] = serde_json::json!("Unknown");
+    assert!(serde_json::from_value::<GladeColorCustomization>(invalid).is_err());
+    let mut missing_fences = valid;
+    let fences = missing_fences
+        .as_object_mut()
+        .unwrap()
+        .remove("fences")
+        .unwrap();
+    missing_fences["fence"] = fences;
+    assert!(serde_json::from_value::<GladeColorCustomization>(missing_fences).is_err());
+}

+    pub fn native_tag(self) -> u8 { self as u8 }
+}
+impl TryFrom<u8> for ArchType {
+    type Error=u8;
+    fn try_from(value:u8)->Result<Self,u8> {
+        match value { 0=>Ok(Self::FollowTerrain), 1=>Ok(Self::ConstantMaxHeight), _=>Err(value) }

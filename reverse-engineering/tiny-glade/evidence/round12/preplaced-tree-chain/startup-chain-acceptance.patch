+// Test-only device boundary; full mapped storage is retained and written below.
+#[derive(Default)]
+struct Device(AtomicU64);
+impl GraphicsDevice for Device {
+    fn create_buffer(
+        &self,
+        desc: &BufferDesc,
+        _: &str,
+        _: Option<&[u8]>,
+    ) -> Result<Buffer, rhapsody_boundary::BackendError> {
+        Ok(Buffer {
+            id: self.0.fetch_add(1, Ordering::Relaxed) + 1,
+            byte_size: desc.size as u64,
+            ..Default::default()
+        })
+    }
+    fn update_buffer_bytes(
+        &self,
+        _: &Buffer,
+        _: &[u8],
+        _: &[Range<usize>],
+        _: usize,
+    ) -> Result<(), rhapsody_boundary::BackendError> {
+        Ok(())
+    }
+    fn mapped_slice_mut(&self, buffer: &Buffer) -> Option<&mut [u8]> {
+        let data =
+            Box::leak(vec![0u128; (buffer.byte_size as usize).div_ceil(16)].into_boxed_slice());
+        // Test allocation is aligned for every buffer used here and outlives World.
+        Some(unsafe {
+            std::slice::from_raw_parts_mut(data.as_mut_ptr().cast(), buffer.byte_size as usize)
+        })
+    }
+}
+fn mark_raster(raster: &mut WorldRaster<512>, x: f32) {
+    let center = ((x / 130.0 + 0.5) * 512.0) as usize;
+    for z in 252..=260 {
+        for c in center - 4..=center + 4 {
+            raster.composite_mut()[z * 512 + c] = 255;
+        }
+    }
+}
+fn world() -> World {
+    let device = Device::default();
+    let mut world = World::new();
+    let mut gpu = GpuWorld::new(&device);
+    let kind = GpuWorldSubsetKind::Canopy;
+    gpu.assign_subset(
+        kind,
+        GpuWorldSubset::Owned(OwnedGpuWorldSubset::new::<PlacementDataSsbo>(&device, kind)),
+    );
+    world.insert_resource(gpu);
+    let name = PrefabName::new("tree/legacy-acceptance");
+    let mut library = PrefabLibrary::default();
+    library.add(
+        name.clone(),
+        Prefab {
+            parts: vec![PrefabPart {
+                rt_kind: 2,
+                ..Default::default()
+            }],
+        },
+    );
+    world.insert_resource(library);
+    let mut mesh = Mesh::new("legacy-acceptance");
+    mesh.set_indices(vec![0, 1, 2]);
+    let mut atlas = MeshAtlasLibrary::default();
+    atlas.add(kind, name.clone(), &mesh);
+    world.insert_resource(atlas);
+    world.insert_resource(ActiveSession::new(SessionId::new(), SessionMeta::default()));
+    world.init_resource::<AudioTriggerLibrary>();
+    world.init_resource::<RtWorld>();
+    world.init_resource::<PrefabsToDelete>();
+    world.init_resource::<Events<SpawnPrefabCmd>>();
+    world.init_resource::<Events<DespawnPrefabCmd>>();
+    world.init_resource::<Events<SpawnPreplacedTrees>>();
+    world.init_resource::<Events<DeleteTreeCmd>>();
+    world.init_resource::<TreeStorage>();
+    world.insert_resource(History::<()>::empty_glade());
+    world.insert_resource(PathRaster::new(DirtyTilePublisher::unique()));
+    world.insert_resource(Cobblestone1Raster::new(DirtyTilePublisher::unique()));
+    world.insert_resource(Cobblestone2Raster::new(DirtyTilePublisher::unique()));
+    world.insert_resource(Cobblestone3Raster::new(DirtyTilePublisher::unique()));
+    let mut water = WaterRaster::new(DirtyTilePublisher::unique());
+    mark_raster(&mut water, -15.0);
+    world.insert_resource(water);
+    let mut garden = GardenRaster::new(DirtyTilePublisher::unique());
+    mark_raster(&mut garden, 5.0);
+    world.insert_resource(garden);
+    mark_raster(&mut world.resource_mut::<PathRaster>(), 25.0);
+    let mut walls = WallSpatialHash::default();
+    walls.add_segment(
+        country_core::systems::wall::wall_state::wall_spatial_hash::WallSpatialSegment {
+            endpoints: [[44.5, -0.5], [45.5, 0.5]],
+            source_u: [0.0, 1.0],
+            relative_heights: [1.0; 2],
+            terrain_heights: [0.0; 2],
+            wall: country_core::resources::walls::WallId(90),
+        },
+    );
+    world.insert_resource(walls);
+    let mut ssbos = AssetSsboLibrary::new();
+    ssbos.add_new::<TerrainRockMaskSsbo>(&device);
+    let rock = ssbos.get_mut::<TerrainRockMaskSsbo>().unwrap();
+    assert_eq!(rock.mapped.len(), 0x2000);
+    let xi = ((-35.0f32 / 130.0 + 0.5) * 512.0) as usize;
+    let index = 256 * 512 + xi;
+    rock.mapped[index >> 5].0 |= 1 << (index & 31);
+    assert_eq!(
+        TerrainRockMaskSsbo::sample_mapped_at_world_xz(&rock.mapped[..], -35.0, 0.0),
+        1
+    );
+    world.insert_resource(ssbos);
+    // These are actual reserved entities/commands, not pre-inserted query components.
+    for (i, x) in [-55.0, -35.0, -15.0, 5.0, 25.0, 45.0]
+        .into_iter()
+        .enumerate()
+    {
+        let entity = world
+            .spawn(ConvertedPreplacedTree("tree/legacy-acceptance".into()))
+            .id();
+        let id = TreeStorageIndex(100001 + i as u64);
+        world.resource_mut::<TreeStorage>().insert(
+            id,
+            TreeStorageEntry {
+                entity,
+                position: glam::Vec3::splat(999.0),
+            },
+        );
+        world.send_event(SpawnPrefabCmd {
+            prefab_name: Some(name.clone()),
+            entity: Some(entity),
+            position: glam::Vec3::new(x, 2.0, 0.0),
+            scale: 0.75,
+            rotation: 110.3,
+            variant: 52,
+            one: 2.2,
+            flags: [0; 16],
+            mode: 0,
+        });
+    }
+    // Native missing/dead query entries are skipped, never synthesized from storage.
+    let dead = world.spawn_empty().id();
+    world.despawn(dead);
+    world.resource_mut::<TreeStorage>().insert(
+        TreeStorageIndex(100010),
+        TreeStorageEntry {
+            entity: dead,
+            position: glam::Vec3::ZERO,
+        },
+    );
+    let missing = world.spawn_empty().id();
+    world.resource_mut::<TreeStorage>().insert(
+        TreeStorageIndex(100011),
+        TreeStorageEntry {
+            entity: missing,
+            position: glam::Vec3::ZERO,
+        },
+    );
+    world
+}
+#[test]
+fn nonempty_prefab_runtime_is_materialized_before_third_update_conversion() {
+    let mut world = world();
+    world.send_event(SpawnPreplacedTrees);
+    // Reader batch coalescing must not reset the delay once per request.
+    world.send_event(SpawnPreplacedTrees);
+    let mut schedule = Schedule::default();
+    schedule.add_systems((spawn_prefab_commands, convert_preplaced_trees::<()>).chain());
+    schedule.run(&mut world);
+    assert_eq!(world.query::<&PrefabInstanceData>().iter(&world).count(), 6);
+    assert_eq!(world.resource::<GpuWorld>().total_instance_count, 6);
+    assert!(world.resource::<History<()>>().ledger().entries.is_empty());
+    schedule.run(&mut world);
+    assert!(world.resource::<History<()>>().ledger().entries.is_empty());
+    schedule.run(&mut world);
+    let ledger = world.resource::<History<()>>().ledger();
+    assert_eq!((ledger.cursor, ledger.entries.len()), (0, 1));
+    assert_eq!(ledger.entries[0].edits.len(), 1);
+    let EditType::Tree(edit) = &ledger.entries[0].edits[0] else {
+        panic!("expected real tree edit")
+    };
+    let TreeEdit::Place(data) = &**edit else {
+        panic!("expected original Place")
+    };
+    assert_eq!(data.storage_index, Some(TreeStorageIndex(100001)));
+    assert_eq!(data.position, glam::Vec3::new(-55.0, 2.0, 0.0));
+    assert_eq!(
+        (data.scale, data.rotation_degrees, data.id),
+        (0.75, 110.3, 52)
+    );
+    assert!(data.is_preplaced);
+    let mut deleted = world
+        .resource::<Events<DeleteTreeCmd>>()
+        .iter_current_update_events()
+        .map(|e| e.id)
+        .collect::<Vec<_>>();
+    deleted.sort_unstable();
+    assert_eq!(deleted, vec![100002, 100003, 100004, 100005, 100006]);
+    schedule.run(&mut world);
+    assert_eq!(world.resource::<History<()>>().ledger().entries.len(), 1);
+}
+#[test]
+fn absence_of_a_legacy_request_never_creates_a_starting_edit_or_blocks_current_sessions() {
+    let mut world = world();
+    let mut schedule = Schedule::default();
+    schedule.add_systems((spawn_prefab_commands, convert_preplaced_trees::<()>).chain());
+    for _ in 0..6 {
+        schedule.run(&mut world);
+    }
+    assert_eq!(world.resource::<GpuWorld>().total_instance_count, 6);
+    assert!(world.resource::<History<()>>().ledger().entries.is_empty());
+    assert!(world.resource::<Events<DeleteTreeCmd>>().is_empty());
+}

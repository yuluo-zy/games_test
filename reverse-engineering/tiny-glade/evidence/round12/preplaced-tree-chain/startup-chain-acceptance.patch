+/// Explicit asset-dependent acceptance. Run this one test with the process cwd
+/// set to the original distribution directory. It never changes global cwd or
+/// writes the original assets. The per-name one-part prefab is a test fixture;
+/// the real prefab build/Nani algorithm and the real asset producer execute.
+#[test]
+#[ignore = "requires the original distribution as process working directory"]
+fn shipped_themes_execute_actual_asset_producer_and_nonempty_delayed_converter() {
+    use country_core::{
+        resources::session::GladeType,
+        startup::spawn_preplaced_trees::{
+            TREES_FILE_NAME, load_tree_groups, load_tree_placements, spawn_preplaced_trees,
+        },
+    };
+    for (theme, count) in [
+        (GladeType::Summer, 270usize),
+        (GladeType::Olden, 198),
+        (GladeType::Flowery, 159),
+        (GladeType::Autumn, 281),
+        (GladeType::Winter, 160),
+    ] {
+        let device = Device::default();
+        let mut world = World::new();
+        let session = ActiveSession::new(
+            SessionId::new(),
+            SessionMeta {
+                glade: theme,
+                ..Default::default()
+            },
+        );
+        let dir = session.assets_root();
+        assert!(
+            dir.join(TREES_FILE_NAME).is_file(),
+            "run only from the original distribution directory"
+        );
+        let groups = load_tree_groups(dir.join(TREES_FILE_NAME)).unwrap();
+        let mut expected = Vec::new();
+        let mut library = PrefabLibrary::default();
+        let mut atlas = MeshAtlasLibrary::default();
+        let kind = GpuWorldSubsetKind::Canopy;
+        for group in groups {
+            if group.prefab == "clearing/tree/bush" {
+                continue;
+            }
+            let name = PrefabName::new(&group.prefab);
+            if !library.has(name.as_name_ref()) {
+                library.add(
+                    name.clone(),
+                    Prefab {
+                        parts: vec![PrefabPart {
+                            rt_kind: 2,
+                            ..Default::default()
+                        }],
+                    },
+                );
+                let mut mesh = Mesh::new("asset-receipt-test-part");
+                mesh.set_indices(vec![0, 1, 2]);
+                atlas.add(kind, name, &mesh);
+            }
+            for mut placement in load_tree_placements(&dir, &group).unwrap() {
+                if placement.position.x.abs() < 65.0 && placement.position.z.abs() < 65.0 {
+                    placement.custom0 = group.billboard_expansion_scale.to_bits();
+                    expected.push((placement, group.prefab.clone()));
+                }
+            }
+        }
+        assert_eq!(expected.len(), count);
+        let mut gpu = GpuWorld::new(&device);
+        gpu.assign_subset(
+            kind,
+            GpuWorldSubset::Owned(OwnedGpuWorldSubset::new::<PlacementDataSsbo>(&device, kind)),
+        );
+        world.insert_resource(gpu);
+        world.insert_resource(library);
+        world.insert_resource(atlas);
+        world.insert_resource(session);
+        world.init_resource::<AudioTriggerLibrary>();
+        world.init_resource::<RtWorld>();
+        world.init_resource::<PrefabsToDelete>();
+        world.init_resource::<TreeStorage>();
+        world.init_resource::<Events<SpawnPrefabCmd>>();
+        world.init_resource::<Events<DespawnPrefabCmd>>();
+        world.init_resource::<Events<SpawnPreplacedTrees>>();
+        world.init_resource::<Events<DeleteTreeCmd>>();
+        world.insert_resource(History::<()>::empty_glade());
+        world.insert_resource(WallSpatialHash::default());
+        world.insert_resource(PathRaster::new(DirtyTilePublisher::unique()));
+        world.insert_resource(Cobblestone1Raster::new(DirtyTilePublisher::unique()));
+        world.insert_resource(Cobblestone2Raster::new(DirtyTilePublisher::unique()));
+        world.insert_resource(Cobblestone3Raster::new(DirtyTilePublisher::unique()));
+        world.insert_resource(WaterRaster::new(DirtyTilePublisher::unique()));
+        world.insert_resource(GardenRaster::new(DirtyTilePublisher::unique()));
+        let ssbos = AssetSsboLibrary::new();
+        ssbos.add_new::<TerrainRockMaskSsbo>(&device);
+        assert_eq!(
+            ssbos.get::<TerrainRockMaskSsbo>().unwrap().mapped.len(),
+            0x2000
+        );
+        world.insert_resource(ssbos);
+        let mut schedule = Schedule::default();
+        schedule.add_systems(
+            (
+                spawn_preplaced_trees,
+                spawn_prefab_commands,
+                convert_preplaced_trees::<()>,
+            )
+                .chain(),
+        );
+        world.send_event(SpawnPreplacedTrees);
+        schedule.run(&mut world);
+        assert_eq!(world.resource::<TreeStorage>().iter().count(), count);
+        assert_eq!(
+            world.query::<&PrefabInstanceData>().iter(&world).count(),
+            count
+        );
+        assert_eq!(
+            world.resource::<GpuWorld>().total_instance_count,
+            count as u64
+        );
+        assert!(world.resource::<History<()>>().ledger().entries.is_empty());
+        for (i, (placement, name)) in expected.iter().enumerate() {
+            let id = TreeStorageIndex(100001 + i as u64);
+            let entry = world.resource::<TreeStorage>().get(id).unwrap();
+            assert_eq!(
+                world.get::<PrefabInstanceData>(entry.entity).unwrap().0,
+                *placement
+            );
+            assert_eq!(
+                world
+                    .get::<ConvertedPreplacedTree>(entry.entity)
+                    .unwrap()
+                    .0
+                    .as_str(),
+                name
+            );
+            let tree = world
+                .get::<country_core::components::TreeComponent>(entry.entity)
+                .unwrap();
+            assert_eq!(tree.id, id.0);
+            assert!(tree.is_preplaced);
+            let audio = world
+                .get::<country_core::systems::audio::tree_audio::TreeAmbience>(entry.entity)
+                .unwrap();
+            assert_eq!(
+                audio.position,
+                placement.position + glam::Vec3::new(0.0, 10.0, 0.0)
+            );
+        }
+        schedule.run(&mut world);
+        assert!(world.resource::<History<()>>().ledger().entries.is_empty());
+        schedule.run(&mut world);
+        let ledger = world.resource::<History<()>>().ledger();
+        assert_eq!((ledger.cursor, ledger.entries.len()), (0, 1));
+        assert_eq!(ledger.entries[0].edits.len(), count);
+        let mut indices = ledger.entries[0]
+            .edits
+            .iter()
+            .map(|edit| {
+                let EditType::Tree(edit) = edit else {
+                    panic!("tree")
+                };
+                let TreeEdit::Place(data) = &**edit else {
+                    panic!("place")
+                };
+                data.storage_index.unwrap().0
+            })
+            .collect::<Vec<_>>();
+        indices.sort_unstable();
+        assert_eq!(indices, (100001..100001 + count as u64).collect::<Vec<_>>());
+        assert!(world.resource::<Events<DeleteTreeCmd>>().is_empty());
+    }
+}

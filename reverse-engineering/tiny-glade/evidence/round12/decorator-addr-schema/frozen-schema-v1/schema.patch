+        fn retained(original: &serde_json::Value, saved: &serde_json::Value) {
+            match original {
+                serde_json::Value::Object(map) => {
+                    for (key, value) in map {
+                        retained(value, saved.get(key).expect("original field missing"));
+                    }
+                }
+                serde_json::Value::Array(values) => {
+                    let actual = saved.as_array().unwrap();
+                    assert_eq!(values.len(), actual.len());
+                    for (a, b) in values.iter().zip(actual) {
+                        retained(a, b);
+                    }
+                }
+                serde_json::Value::Number(number) => {
+                    let actual = saved.as_number().unwrap();
+                    if let (Some(a), Some(b)) = (number.as_u64(), actual.as_u64()) {
+                        assert_eq!(a, b);
+                    } else {
+                        assert_eq!(
+                            (number.as_f64().unwrap() as f32).to_bits(),
+                            (actual.as_f64().unwrap() as f32).to_bits()
+                        );
+                    }
+                }
+                _ => assert_eq!(original, saved),
+            }
+        }
+        retained(&original, &saved);
+        assert_eq!(saved.as_object().unwrap().len(), 2);
+        for side in ["before", "after"] {
+            assert!(
+                saved[side]
+                    .as_object()
+                    .unwrap()
+                    .keys()
+                    .all(|id| id.parse::<u32>().is_ok())
+            );
+            assert!(saved[side].get("states").is_none() && saved[side].get("removed").is_none());
+        }
+    }
 

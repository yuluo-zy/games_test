+fn closest_rectangle_point(rect:Rectangle2d,point:Vec2)->Vec2 {
+    let (a,b)=rect.get_edge_pts(rect.get_closest_edge_id(point));
+    let d=b-a;let q=point-a;
+    let length=d.y*d.y+d.x*d.x;

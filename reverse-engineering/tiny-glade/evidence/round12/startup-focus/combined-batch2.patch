+        let rect=Rectangle2d{axis:Vec2::new(f(4),f(8)),center:Vec2::new(f(12),f(16)),size:Vec2::new(f(20),f(24))};
+        let d=closest_rectangle_point(rect,point)-point;
+        TREE_SHAPE_GAP>(d.y*d.y+d.x*d.x).sqrt()

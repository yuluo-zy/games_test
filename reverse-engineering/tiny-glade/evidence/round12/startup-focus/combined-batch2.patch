+        installed,
+        "assets/meshes/distant_billboard.json",
+        "distant_billboard",
+        meshes,
+        watch,
+    )?;
+    commands.spawn(DrawableMeshBundle {
+        mesh,
+        shader,
+        transform: Transform::identity(),
+    });
+    Ok(())
+}

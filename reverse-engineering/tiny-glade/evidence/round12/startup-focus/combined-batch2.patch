+fn step(driver: &mut tiny_glade::game_loop::GameFrameDriver, ui: &egui::Context, seen: &mut Seen) {
+    ui.begin_frame(egui::RawInput::default());
+    driver.app_mut().update();
+    let _ = ui.end_frame();
+    let world = driver.app().world();
+    // Observe the real intermediate owner, before original collision filtering
+    // can delete blocked converted trees. A final281-live-tree requirement
+    // would incorrectly prohibit that original algorithm.
+    for entity in world.iter_entities() {
+        use country_core::{
+            components::{ConvertedPreplacedTree, TreeComponent},
+            resources::{
+                prefab::PrefabInstance,
+                rt::RtWorld,
+                tree_storage::{TreeStorage, TreeStorageIndex},
+            },
+            systems::prefab::PrefabInstanceData,
+        };
+        if let (Some(tree), Some(name), Some(data), Some(contents)) = (
+            entity.get::<TreeComponent>(),
+            entity.get::<ConvertedPreplacedTree>(),
+            entity.get::<PrefabInstanceData>(),
+            entity.get::<PrefabInstance>(),
+        ) {
+            if tree.is_preplaced {
+                assert_eq!(
+                    world
+                        .resource::<TreeStorage>()
+                        .get(TreeStorageIndex(tree.id))
+                        .unwrap()
+                        .entity,
+                    entity.id()
+                );
+                assert!(
+                    !contents.gpu_instances.is_empty(),
+                    "legacy spawn has no actual GPU ownership"
+                );
+                assert!(
+                    !contents.rt_meshes.is_empty(),
+                    "legacy spawn has no actual RT ownership"
+                );
+                for handle in &contents.rt_meshes {
+                    assert!(world.resource::<RtWorld>().get(*handle).is_some());
+                }
+                seen.legacy_owners.insert(
+                    tree.id,
+                    ObservedLegacyTree {
+                        entity: entity.id(),
+                        name: name.0.as_str().to_owned(),
+                        position: data.0.position.to_array(),
+                    },
+                );
+            }
+        }
+    }
+    seen.new_count += seen
+        .new
+        .read(world.resource::<Events<NewSessionStartedCmd>>())
+        .count();
+    seen.legacy_count += seen.legacy.read(world.resource::<Events<country_core::resources::history::tree_edit::SpawnPreplacedTrees>>()).count();
+    seen.session_count += seen
+        .sessions
+        .read(world.resource::<Events<SessionLoadedCmd>>())
+        .count();
+    seen.complete_count += seen
+        .complete
+        .read(world.resource::<Events<LoadingGameComplete>>())
+        .count();
+    seen.clear_false += seen
+        .clear
+        .read(world.resource::<Events<ClearCanvasCmd>>())
+        .filter(|e| !e.0)
+        .count();

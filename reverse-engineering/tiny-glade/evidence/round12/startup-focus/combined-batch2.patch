+// Test-only device boundary; full mapped storage is retained and written below.
+#[derive(Default)]
+struct Device(AtomicU64);
+impl GraphicsDevice for Device {
+    fn create_buffer(
+        &self,
+        desc: &BufferDesc,
+        _: &str,
+        _: Option<&[u8]>,
+    ) -> Result<Buffer, rhapsody_boundary::BackendError> {
+        Ok(Buffer {
+            id: self.0.fetch_add(1, Ordering::Relaxed) + 1,
+            byte_size: desc.size as u64,
+            ..Default::default()
+        })
+    }
+    fn update_buffer_bytes(
+        &self,
+        _: &Buffer,
+        _: &[u8],
+        _: &[Range<usize>],
+        _: usize,
+    ) -> Result<(), rhapsody_boundary::BackendError> {
+        Ok(())
+    }
+    fn mapped_slice_mut(&self, buffer: &Buffer) -> Option<&mut [u8]> {
+        let data =
+            Box::leak(vec![0u128; (buffer.byte_size as usize).div_ceil(16)].into_boxed_slice());
+        // Test allocation is aligned for every buffer used here and outlives World.
+        Some(unsafe {
+            std::slice::from_raw_parts_mut(data.as_mut_ptr().cast(), buffer.byte_size as usize)
+        })
+    }
+}

+fn file_mesh(
+    root: &Path,
+    path: &str,
+    name: &str,
+    meshes: &AssetMeshLibrary,
+    watch: &MeshWatch,
+) -> Handle<Mesh> {
+    let path = root.join(path);
+    let mesh = crate::utils::load_json::load_json_as_mesh(
+        path.to_str().expect("critter mesh path must be UTF-8"),
+    );
+    publish_mesh(mesh, name, meshes, watch)

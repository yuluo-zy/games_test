+        storage: &LiveDecoratorStorage,
+        resources: &DecoratorArchivalResources<'_>,
+        reason: &str,
+    ) {
+        for address in addresses {
+            self.archive_current_decorators_at_address(address, storage, resources, reason);
         }
     }
 }

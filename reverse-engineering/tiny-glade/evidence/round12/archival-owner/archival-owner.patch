+            // the game's semantic state comparison (float ordered equality).
+            let equal: Vec<_> = before
+                .iter()
+                .filter_map(|(id, b)| {
+                    after
+                        .get(id)
+                        .filter(|a| archived_history_equal(b, a))
+                        .map(|_| *id)
+                })
+                .collect();
+            for id in equal {
+                before.remove(&id);
+                after.remove(&id);
+            }

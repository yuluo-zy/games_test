+/// `packet.state` 第 0 字节 `(b & 0xf3) | v`（O：`and al, -0xd; or al, v`）。
+pub fn cull_state(state: u32, v: u8) -> u32 {
+    (state & !0x0c) | v as u32
+}
+
+fn set_cull(b: &mut DrawBuilder<'_>, v: u8) {
+    let p = b.packet_mut();
+    p.state.0 = cull_state(p.state.0, v);
+}

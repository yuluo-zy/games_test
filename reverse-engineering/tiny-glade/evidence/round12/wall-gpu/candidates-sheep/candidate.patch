+pub fn nani_draw_world(b: DrawBuilder<'_>, kind: GpuWorldSubsetKind, w: &World) {
+    let gw = res::<GpuWorld>(w);
+    let lib = res::<AssetSsboLibrary>(w);
+    let mut rg = RenderGraph::default();
+    b.nani_draw(kind, gw, lib, &mut rg);

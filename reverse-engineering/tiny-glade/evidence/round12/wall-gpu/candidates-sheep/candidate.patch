+/// 墙高亮 → `(value, tag)`（O：`tag = byte[+0x10]`；`edi = tag != 0 ? dword[+8] : 0`）。真实 `WallHighlight` 的
+/// `ty`/`wall_id` 与该偏移的对应是 I。
+pub fn wall_highlight_param(h: &WallHighlight) -> (i32, i32) {
+    let tag = h.ty;
+    let value = if tag != 0 {
+        h.wall_id.map_or(0, |id| id.0 as u32)
+    } else {
+        0
+    };
+    (value as i32, tag as i32)
+}

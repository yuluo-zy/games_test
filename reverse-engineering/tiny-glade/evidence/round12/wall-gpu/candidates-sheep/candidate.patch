+/// 末张磁盘纹理的文件键：会话字节里存在 `<= 1` 的字节 → `0x4c58d4d61ec450d2`，否则 `-0x1adc8a43cd569b5c`
+/// （O 0x1409b8b60 循环：`cmp byte,1; ja continue`）。
+pub fn env21_last_texture(bytes: &[u8]) -> u64 {
+    if bytes.iter().any(|b| *b <= 1) {
+        0x4c58d4d61ec450d2
+    } else {
+        0xe52375bc32a964a4
+    }
+}

+    pub fn recycle(&mut self, mut callback: impl FnMut(BirdSpot)) {
+        let mut returned = self.returned.lock().unwrap_or_else(|e| e.into_inner());
+        for spot in returned.drain(..) {
+            callback(spot);
+        }
+    }

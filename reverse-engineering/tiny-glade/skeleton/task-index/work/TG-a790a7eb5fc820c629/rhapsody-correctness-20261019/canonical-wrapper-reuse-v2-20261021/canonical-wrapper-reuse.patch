     #[test]
+    fn legacy_coordinate_wrapper_uses_canonical_endpoint_and_degenerate_lane_policy() {
+        let curve = Curve2::try_new(vec![[0.0, 0.0], [3.0, 4.0], [6.0, 0.0]], false).unwrap();
+        for u in [-2.0, 0.0, 2.5, 5.0, curve.length, curve.length + 2.0] {
+            let coordinate = WallSpaceCoord::new_unchecked(u, 2.0);
+            assert_eq!(wall_coord_to_world(&curve, coordinate).unwrap().to_array().map(f32::to_bits),
+                coordinate.to_world_space(&curve).to_array().map(f32::to_bits));
+        }
+        assert_eq!(wall_coord_to_world(&curve, WallSpaceCoord::new_unchecked(-1.0, 2.0)),
+            Ok(Vec3::new(0.6, 2.0, 0.8)));
+        // 原端点零段的NaN会传播到Y；旧手写投影错误地保留有限Y。
+        let repeated = Curve2::try_new(vec![[0.0, 0.0], [0.0, 0.0], [3.0, 4.0]], false).unwrap();
+        let coordinate = WallSpaceCoord::new_unchecked(-1.0, 2.0);
+        let native = coordinate.to_world_space(&repeated);
+        let legacy = wall_coord_to_world(&repeated, coordinate).unwrap();
+        assert!(native.to_array().iter().all(|value| value.is_nan()));
+        assert!(legacy.to_array().iter().all(|value| value.is_nan()));
+        for coordinate in [WallSpaceCoord::new_unchecked(f32::NAN, 0.0),
+            WallSpaceCoord::new_unchecked(0.0, f32::INFINITY)] {
+            assert_eq!(wall_coord_to_world(&curve, coordinate), Err(SubtypeError::InvalidPublishedOutline));
+        }
+        let mut malformed = curve.clone(); malformed.points.truncate(1);
+        assert_eq!(wall_coord_to_world(&malformed, WallSpaceCoord::new_unchecked(0.0, 0.0)),
+            Err(SubtypeError::InvalidPublishedOutline));
+        malformed = curve.clone(); malformed.length = 0.0;
+        assert_eq!(wall_coord_to_world(&malformed, WallSpaceCoord::new_unchecked(0.0, 0.0)),
+            Err(SubtypeError::InvalidPublishedOutline));
+        malformed.length = f32::MIN_POSITIVE;
+        assert_eq!(wall_coord_to_world(&malformed, WallSpaceCoord::new_unchecked(f32::MAX, 0.0)),
+            Err(SubtypeError::InvalidPublishedOutline));
+    }

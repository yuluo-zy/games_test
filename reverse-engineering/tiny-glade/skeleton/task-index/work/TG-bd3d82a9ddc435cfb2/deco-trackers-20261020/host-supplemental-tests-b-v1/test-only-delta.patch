+        assert!(world.resource::<Events<UpdateRtWorldEvent>>().is_empty());
+        assert!(world.resource::<RtWorld>().meshes.is_empty());
+        assert_eq!(lane_headers(&world,entity),headers); assert_deco_payloads(&world,entity);

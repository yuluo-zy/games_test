+                end_2: base,
+                end_3: end,
+                base_size: Vec2::new(1.3, 1.0),
+                size_delta: -0.3,
+            })
+        }
+        _ => {
+            let height = f32::from_bits(params.words[1]);
+            (height > 0.1).then_some(ChimneyBrickSection {
+                end_2: base,
+                end_3: base - height,
+                base_size: Vec2::splat(0.8),
+                size_delta: 0.0,
+            })
+        }

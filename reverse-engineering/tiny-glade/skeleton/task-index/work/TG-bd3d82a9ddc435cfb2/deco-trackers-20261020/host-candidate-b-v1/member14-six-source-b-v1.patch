+pub fn construct_crossbrick_chimney(
+    params: &ChimneyAssemblyParams,
+    section: ChimneyBrickSection,
+    wall: WallId,
+    rng: &fastrand::Rng,
+    writer: &mut SparseInstanceBufferWriter<'_, BrickTransformSsbo>,
+) -> bool {

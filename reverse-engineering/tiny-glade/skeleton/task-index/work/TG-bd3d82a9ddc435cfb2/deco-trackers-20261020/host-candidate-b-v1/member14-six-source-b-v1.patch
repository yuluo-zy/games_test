+    #[test]
+    fn row_seed_directional_intervals_and_rng_survive_emit_failure() {
+        let params = DoorStairsAssemblyParams {
+            words: [0.0f32, 0.0, 1.0, 0.0, 0.4, 0.0, 0.4, 0.9].map(f32::to_bits),
+        };

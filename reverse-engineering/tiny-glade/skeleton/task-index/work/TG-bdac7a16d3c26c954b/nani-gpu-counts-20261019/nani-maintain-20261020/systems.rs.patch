+            let parts = atlas.get_by_name(name);
+            assert_eq!(parts.len(), 1);
+            assert_eq!(parts[0].subset, desc.subset_kind);
+            parts[0].part_index
+        }
+    };
+    gpu_world.update_instance_mesh(active, part as u16);
+}

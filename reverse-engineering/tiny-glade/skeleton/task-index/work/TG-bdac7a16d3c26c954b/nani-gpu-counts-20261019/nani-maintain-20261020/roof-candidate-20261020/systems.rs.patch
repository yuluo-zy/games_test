+pub fn nani_update_roof_floor_for_roofs_ecs(
+    mut rows: Query<(&mut InstanceKey, &Transform, Option<&Roof>, Option<&RoofAnimation>),
+        With<InstanceDataMarker<StoneFloorInstanceData>>>,

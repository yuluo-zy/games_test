+#[derive(Clone, Debug)]
+struct AutoSaveFrameCache {
+    identity: u64,
+    camera: CameraRigParametersCache,
+    tod: crate::resources::time_of_day::TimeOfDay,
+    sheep: Option<crate::resources::critters::sheep::control::SheepControlSnapshot>,

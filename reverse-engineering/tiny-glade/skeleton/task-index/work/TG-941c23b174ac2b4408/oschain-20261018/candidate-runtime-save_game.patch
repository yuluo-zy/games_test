+        use crate::resources::image_formation::ImageFormationConfig;
+        let a = ImageFormationConfig::default_plain();
+        let mut b = a.clone();
+        b._pad_29 = [9; 7];
+        b._pad_3e = [8; 2];
+        b.word_38 = (-0.0f32).to_bits();
+        assert!(image_settings_equal(&a, &b));
+        b.word_38 = f32::NAN.to_bits();

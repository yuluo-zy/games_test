+        let mesh = Arc::new(RaycastMeshData::new_indexed(
+            &[[0, 1, 2]],
+            &[
+                Vec3::new(-1.0, -1.0, -1.0),
+                Vec3::new(1.0, 1.0, -1.0),
+                Vec3::new(0.0, 0.0, 1.0),

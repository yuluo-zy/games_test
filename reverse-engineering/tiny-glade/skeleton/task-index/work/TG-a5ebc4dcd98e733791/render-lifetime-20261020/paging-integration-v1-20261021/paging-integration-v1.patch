+impl ShaderBindingSnapshot {
+    pub fn prepare<'a>(
+        &self,
+        cursor: &mut rhapsody::bindless::BindlessPageCursor,
+        push: &[u8],
+        resources: impl Iterator<Item = (BindingLocation, u32, &'a BindlessResource, bool)> + Clone,

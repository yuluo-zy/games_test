+    "Retain",
+    "NativeBind",
+    "NativePush",
+    "CounterLockWait",
+    "CounterUpdate",
+    "Finish",
+    "WithPush",
+];
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(crate) enum RecordCount {

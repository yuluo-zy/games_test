+    CompleteGroup,
+    GroupLockWait,
+    RequireSlots,
+    DescriptorReserve,
+    UpdateLockWait,
+    UpdateDriver,
+    ManagedValidate,
+    Retain,
+    NativeBind,
+    NativePush,
+    CounterLockWait,
+    CounterUpdate,
+    Finish,
+    WithPush,
+}
+const RECORD_PHASES: usize = 15;
+const RECORD_PHASE_NAMES: [&str; RECORD_PHASES] = [
+    "Requirements",
+    "CompleteGroup",
+    "GroupLockWait",
+    "RequireSlots",
+    "DescriptorReserve",
+    "UpdateLockWait",
+    "UpdateDriver",

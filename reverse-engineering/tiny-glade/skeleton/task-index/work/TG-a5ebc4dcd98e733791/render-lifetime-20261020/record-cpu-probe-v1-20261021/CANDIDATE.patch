+    NativePushCalls,
+    FinishCalls,
+    WithPushCalls,
+    BindingChecks,
+}
+const RECORD_COUNTS: usize = 26;
+const RECORD_COUNT_NAMES: [&str; RECORD_COUNTS] = [
+    "RequirementResources",
+    "RequirementUnique",
+    "GroupAttempts",
+    "CurrentPageReuse",
+    "PageSearches",
+    "PagesCreated",
+    "InsufficientRetries",
+    "SampledImageWrites",
+    "StorageImageWrites",

+        assert_eq!(sphere.local_transform().rotation, Quat::IDENTITY);
+        let child = RaycastMeshData::new_cuboid_at(Vec3::splat(2.0), Vec3::new(2.0, 0.0, 0.0));
+        let compound =
+            RaycastMeshData::new_compound(vec![child], [0, 0, 0, 0, 0, 0, 0, 1.0f32.to_bits()]);

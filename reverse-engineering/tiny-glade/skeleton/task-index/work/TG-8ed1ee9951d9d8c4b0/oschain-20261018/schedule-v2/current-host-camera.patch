+    #[test]
+    fn original_set9_then_set10_updates_live_camera_ray_terrain_and_capture() {
+        let (mut app, _directory) = fixture();
+        let before = app.world().resource::<MainCamera>().eye_position();
+        {
+            let mut input = app.world_mut().resource_mut::<MainActionSet>();
+            input.analog[2] = glam::Vec2::new(20.0, 10.0);
+            input.digital[2] = DigitalActionState {
+                phase: DigitalActionPhase::JustPressed,
+                timer_seconds: 0.0,
+            };
+        }
+        let following_hit = app
+            .world_mut()
+            .spawn((
+                FollowMouse(false),
+                Transform::from_translation(glam::Vec3::splat(999.0)),
+            ))
+            .id();
+        let following_ray = app
+            .world_mut()
+            .spawn((FollowMouse(true), Transform::identity()))
+            .id();
+        app.update();
+        let world = app.world();
+        let camera = world.resource::<MainCamera>();
+        assert_ne!(camera.eye_position(), before);
+        let ray = *world.resource::<CameraCursorRay>();
+        let expected = ::utils::geometry::Ray::from_mouse_ss(
+            world.resource::<CursorPositionSS>().0,
+            world.resource::<WindowSize>().as_vec2(),
+            camera.read_matrix(0x40),
+            camera.read_matrix(0xc0),
+        );
+        assert_eq!(ray.origin, expected.origin);
+        assert_eq!(ray.dir, expected.direction);
+        let hit = world
+            .resource::<TerrainHeightsData>()
+            .intersect_ray(ray.ray(), f32::MAX)
+            .expect("real initialized height grid intersects the original camera ray");
+        let plane = ray.intersect_with_xz_plane(0.0);
+        let expected_hit = if (hit.position - ray.origin).length() > (plane - ray.origin).length() {
+            plane
+        } else {
+            hit.position
+        };
+        let cursor = world.resource::<CursorTerrainRaycast>();
+        assert_eq!(cursor.tag, 1);
+        assert_eq!(cursor.pos, expected_hit);
+        assert_eq!(
+            world.get::<Transform>(following_hit).unwrap().translation,
+            expected_hit
+        );
+        assert_eq!(
+            world.get::<Transform>(following_ray).unwrap().translation,
+            ray.origin + ray.dir * 45.0
+        );
+        // Terrain ran before the original final (capture,readback) pair. The
+        // genuine capture request emitted by set9 is now the OS command.
+        assert_eq!(
+            world.resource::<CursorCapturedPosition>().0,
+            Some([512.0, 384.0].into())
+        );
+        let commands = world.resource::<Events<OsCursorCaptureCmd>>();
+        let mut reader = commands.get_cursor();
+        assert!(reader
+            .read(commands)
+            .any(|cmd| matches!(cmd, OsCursorCaptureCmd::Capture(_))));
+        assert_eq!(*world.resource::<MouseDepthValue>(), MouseDepthValue::new());
+        assert_eq!(world.resource::<Events<AudioCursorMoved>>().len(), 1);
+        let requests = world.resource::<Events<CursorCaptureCmd>>();
+        assert!(!requests.is_empty());
+    }
+
+    #[test]
+    fn original_reset_precedes_snapshot_and_paused_gate_skips_set10() {
+        let (mut app, _directory) = fixture();
+        let initial = app.world().resource::<MainCamera>().store_parameters();
+        app.world_mut()
+            .resource_mut::<CameraSnapshot>()
+            .snapshots
+            .extend([initial, initial]);
+        app.world_mut()
+            .resource_mut::<DebugGui>()
+            .camera_snapshot_command = CameraSnapshotCommand::Insert;
+        app.world_mut().send_event(NewSessionStartedCmd);
+        app.update();
+        // The real reset cleared both old entries; the same frame's snapshot
+        // system consumed GUI Insert after reset, leaving exactly one entry.
+        assert_eq!(app.world().resource::<CameraSnapshot>().snapshots.len(), 1);
+        assert_eq!(
+            app.world().resource::<DebugGui>().camera_snapshot_command,
+            CameraSnapshotCommand::None
+        );
+        let ray = *app.world().resource::<CameraCursorRay>();
+        app.world_mut().resource_mut::<GameTime>().ran = false;
+        *app.world_mut().resource_mut::<WindowSize>() = WindowSize::new(1280, 720);
+        app.world_mut().resource_mut::<CursorPositionSS>().0 = [1100.0, 600.0].into();
+        app.world_mut()
+            .resource_mut::<DebugGui>()
+            .camera_snapshot_command = CameraSnapshotCommand::Insert;
+        app.update();
+        let world = app.world();
+        assert_eq!(world.resource::<MainCamera>().aspect(), 1280.0 / 720.0);
+        assert_eq!(world.resource::<CameraSnapshot>().snapshots.len(), 1);
+        assert_eq!(
+            world.resource::<DebugGui>().camera_snapshot_command,
+            CameraSnapshotCommand::Insert
+        );
+        assert_eq!(world.resource::<CameraCursorRay>().origin, ray.origin);
+        assert_eq!(world.resource::<CameraCursorRay>().dir, ray.dir);
+    }

+    fn fixture() -> (App, tempfile::TempDir) {
+        // Real original camera parameters; the small metadata envelope selects
+        // the actual Autumn session branch and is explicit fixture input.
+        let camera_path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../country-core/tests/fixtures/original-intro-camera-b.json");
+        let parameters: CameraRigParametersCache =
+            serde_json::from_slice(&std::fs::read(camera_path).unwrap()).unwrap();
+        let mut camera = MainCamera::new(4.0 / 3.0);
+        camera.load_parameters(&parameters, false);
+        camera.finish_loaded_normal_interpolation(false).unwrap();
+        let directory = tempfile::tempdir().unwrap();
+        let metadata = directory.path().join("meta.json");
+        std::fs::write(&metadata, br#"{"state":{"glade":"Autumn"},"version":1}"#).unwrap();
+        let session = ActiveSession::new(
+            SessionId::new(),
+            SessionMeta::try_load_from_path(metadata).unwrap(),
+        );
+        let mut app = App::new();
+        for stage in 0..44 {
+            app.configure_sets(
+                bevy_app::Update,
+                GameSystemSet(stage).before(GameSystemSet(stage + 1)),
+            );
+        }
+        // These are the same production installers, not a copied system tuple.
+        register_input_events(app.world_mut());
+        install_camera_runtime(&mut app);
+        install_history_and_wall_runtime(&mut app, false);
+        app.insert_resource(camera);
+        app.insert_resource(session);
+        app.insert_resource(bevy_state::state::State::new(AppLoadingState::Game));
+        app.insert_resource(GameTime {
+            delta: 1.0 / 60.0,
+            ran: true,
+            ..Default::default()
+        });
+        app.world_mut()
+            .resource_mut::<bevy_time::Time>()
+            .advance_by(std::time::Duration::from_secs_f32(1.0 / 60.0));
+        app.insert_resource(WindowSize::new(1024, 768));
+        app.insert_resource(CursorPositionSS([512.0, 384.0].into()));
+        app.init_resource::<CursorCapturedPosition>();

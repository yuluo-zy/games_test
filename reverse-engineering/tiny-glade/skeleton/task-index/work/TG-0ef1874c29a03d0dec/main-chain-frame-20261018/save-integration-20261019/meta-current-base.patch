+            11 => CommanderOutcome::Freeze { paused: false },
+            17 => CommanderOutcome::SaveAndQuit,
+            18 => CommanderOutcome::QuitWithoutSaving,
+            19 => CommanderOutcome::QuitProcess {
+                status: command.payloads[0] as i32,

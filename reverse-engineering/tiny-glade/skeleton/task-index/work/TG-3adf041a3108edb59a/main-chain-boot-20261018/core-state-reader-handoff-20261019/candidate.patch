+#[cfg(test)]
+mod decorator_state_decode_tests {
+    use super::*;
+    use crate::resources::walls::decorator::{DecoratorId, DecoratorIdGen};
+    use serde_json::json;
+
+    fn required() -> Value {
+        json!({"dst":{"Terrain":{"pos_xz":[1.25,-2.5]}},
+            "ty":"CottageWindow","rank":{"x":7},"seed":0x89abcdefu32})
+    }
+
+    #[test]
+    fn native_required_defaults_alias_and_integer_bounds_are_preserved() {
+        let wire = required();
+        let s = deserialize_decorator_history_state(wire.clone()).unwrap();
+        assert_eq!(s.rank, 7);
+        assert_eq!(s.ty, 56);
+        assert_eq!(s.u28, 0x89abcdef00000000);
+        assert_eq!(
+            (s.u30, s.u34, s.u40, s.u44, s.u49, s.u4b, s.style),
+            (0, 0, 0, 0, 0, 0, 0)
+        );
+        assert_eq!((s.u38, s.u3c), (1.0f32.to_bits(), 1.0f32.to_bits()));
+        assert_eq!((s.u4c, s.u4d), (1, 1));
+        assert_eq!(decorator_history_state_json(&s).unwrap(), wire);
+        for key in ["dst", "ty", "rank", "seed"] {
+            let mut missing = wire.clone();
+            missing.as_object_mut().unwrap().remove(key);
+            assert!(
+                deserialize_decorator_history_state(missing).is_err(),
+                "{key}"
+            );
+        }
+        let mut old = wire.clone();
+        old["chimney_h_offset"] = json!(-3.75);
+        old["unknown_future"] = json!({"ignored":[1,2,3]});
+        let state = deserialize_decorator_history_state(old.clone()).unwrap();
+        assert_eq!(state.u30, (-3.75f32).to_bits());
+        old["h_offset"] = json!(0.5);
+        assert!(
+            deserialize_decorator_history_state(old).is_err(),
+            "alias duplicate"
+        );
+        for (key, value) in [
+            ("rank", json!({"x":256})),
+            ("clv", json!(256)),
+            ("seed", json!(4294967296u64)),
+            ("color_id", json!(-1)),
+            ("lantern_brightness", Value::Null),
+            ("allow_connection", json!(1)),
+        ] {
+            let mut invalid = wire.clone();
+            invalid[key] = value;
+            assert!(
+                deserialize_decorator_history_state(invalid).is_err(),
+                "{key}"
+            );
+        }
+    }
+
+    #[test]
+    fn four_destination_payloads_roundtrip_every_active_field() {
+        let destinations = [
+            json!({"Wall":{"coord":{"x":1.25,"y":-2.5},"anchor":{
+                "wall_height_relative_y":0.75,"anchor_ws":[3.0,4.0,5.0],
+                "corner":255,"platform":0x100000007u64,"is_bottom_door":true,"side":"Inner"}}}),
+            json!({"Roof":{"mesh_uv":[0.25,0.75],"relative_yaw_radians":-7.5}}),
+            json!({"Terrain":{"pos_xz":[-6.0,9.0],"yaw_radians":1.5}}),
+            json!({"Stair":{"graph_edge":[0xffffffffu32,9],"uv":[0.4,0.8],"yaw_radians":-2.0}}),
+        ];
+        for dst in destinations {
+            let mut wire = required();
+            wire["dst"] = dst.clone();
+            // Nondefault fields remain in the HistoryState even if the selected
+            // decorator type later interprets only its own extra-style fields.
+            for (key, value) in [
+                ("color_id", json!(0xffffffffu32)),
+                ("clv", json!(255)),
+                ("h_offset", json!(2.0)),
+                ("allow_connection", json!(false)),
+                ("window_light_color", json!(23)),
+                ("lantern_brightness", json!(0.5)),
+                ("chimney_smoke", json!(false)),
+                ("stair_width", json!(2.5)),
+                ("ladder_color", json!(27)),
+                ("railing", json!("Wooden")),
+                ("stairs_supports", json!("None")),
+                ("magic_color", json!(31)),

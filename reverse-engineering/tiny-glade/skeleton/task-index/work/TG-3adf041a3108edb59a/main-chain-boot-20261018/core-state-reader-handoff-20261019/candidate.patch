+            let s = deserialize_decorator_history_state(wire.clone()).unwrap();
+            let output = decorator_history_state_json(&s).unwrap();
+            // Values use exact binary f32 conversion, as does the original Value
+            // visitor. Compare through the actual f32-backed projection.
+            let again = deserialize_decorator_history_state(output.clone()).unwrap();
+            assert_eq!(again.to_bytes(), s.to_bytes());
+            assert_eq!(output["color_id"], 0xffffffffu32);
+            assert_eq!(output["rank"], json!({"x":7}));
+            assert_eq!(output["railing"], "Wooden");
+            assert_eq!(output["stairs_supports"], "None");
+            let variant = dst.as_object().unwrap().keys().next().unwrap();
+            assert!(output["dst"].get(variant).is_some());

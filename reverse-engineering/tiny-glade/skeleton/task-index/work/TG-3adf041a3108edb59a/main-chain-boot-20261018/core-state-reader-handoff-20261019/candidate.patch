+impl DecoratorInfoJson {
+    pub fn to_history_state(
+        &self,
+    ) -> crate::resources::history::decorator_edit::DecoratorHistoryState {
+        use crate::resources::history::decorator_edit::DecoratorHistoryState;
+        let dst = self.dst.projected_bytes();
+        let q = |at| u64::from_le_bytes(dst[at..at + 8].try_into().unwrap());
+        let d = |at| u32::from_le_bytes(dst[at..at + 4].try_into().unwrap());
+        DecoratorHistoryState {
+            dst_wall: q(0),
+            dst_secondary: q(8),
+            dst_payload: q(0x10),
+            u18: q(0x18),
+            u20: d(0x20),
+            u24: d(0x24),
+            u28: u64::from(self.color_id) | (u64::from(self.seed) << 32),
+            u30: self.h_offset.to_bits(),
+            u34: self.window_light_color,
+            u38: self.lantern_brightness.to_bits(),
+            u3c: self.stair_width.to_bits(),
+            u40: self.ladder_color,
+            u44: self.magic_color,
+            rank: self.rank.x,
+            u49: self.clv,
+            ty: self.ty.native_tag(),
+            u4b: self.railing as u8,
+            u4c: u8::from(self.allow_connection),
+            u4d: u8::from(self.chimney_smoke),
+            style: self.stairs_supports as u8,
+        }
+    }
+}

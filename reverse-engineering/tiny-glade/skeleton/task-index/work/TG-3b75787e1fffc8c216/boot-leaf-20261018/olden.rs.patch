+//! B olden startup@1415539d0/3588B. Actual six placement sets build
+//! authoritative rectangles; clover drawables share existing shader ownership.
+use crate::{
+    asset_libraries::{
+        mesh_library::AssetMeshLibrary, meshwatch::MeshWatch,
+        placement_data_library::AssetPlacementDataLibrary, shader_library::AssetShaderLibrary,
+    },
+    components::drawable::{AlbedoMap, AlphaMap, NormalMap},
+    render::ssbo::rhapsody_boundary::GraphicsDevice,
+    resources::{
+        preplaced_autoclutter::{PreplacedAutoClutter, PreplacedClutterRegion},
+        session::ActiveSession,
+    },
+    startup::clearing::{drawable, install_json_mesh},
+};
+use bevy_ecs::system::Commands;
+use glam::{Vec2, Vec3};
+use std::path::Path;
+use utils::geometry::Rectangle2d;
+
+#[allow(clippy::too_many_arguments)]
+pub fn startup_olden(
+    root: &Path,
+    device: &dyn GraphicsDevice,
+    session: &ActiveSession,
+    meshes: &AssetMeshLibrary,
+    watch: &MeshWatch,
+    shaders: &AssetShaderLibrary,
+    placements: &mut AssetPlacementDataLibrary,
+    commands: &mut Commands,
+) -> anyhow::Result<PreplacedAutoClutter> {
+    // Original constants, two table rows per kind. No synthetic placements.
+    const TABLE: [(&str, u8, [f32; 2]); 6] = [
+        ("trees/rocks.json", 0, [1.3, 1.3]),
+        ("trees/clearing_edge_rocks.json", 0, [1.3, 1.3]),
+        ("trees/stumps.json", 2, [1.8, 1.9]),
+        ("trees/clearing_edge_tree_stumps.json", 2, [1.8, 1.9]),
+        ("trees/logs.json", 1, [1.8, 4.4]),
+        ("trees/clearing_edge_tree_logs.json", 1, [1.8, 4.4]),
+    ];
+    let mut out = PreplacedAutoClutter::default();
+    for (file, kind, dimensions) in TABLE {
+        let (data, _) = placements.load(device, root.join(session.assets_root()).join(file));
+        for placement in data {
+            // Original uses the transformed local X vector, including scale,
+            // then normalizes its XZ projection. Translation is excluded.
+            let direction = placement
+                .to_transform()
+                .compute_affine()
+                .transform_vector3(Vec3::X);
+            let axis = Vec2::new(direction.x, direction.z).normalize();
+            out.regions.push(PreplacedClutterRegion {
+                shape: Rectangle2d::new(
+                    Vec2::new(placement.position.x, placement.position.z),
+                    Vec2::from_array(dimensions) * placement.scale,
+                    axis,
+                ),
+                kind,
+            });
+        }
+    }
+    let mesh = install_json_mesh(root, "assets/meshes/clover.json", "clover", meshes, watch)?;
+    let shader = shaders
+        .get_raster_handle_by_name("meadow_flower")
+        .expect("called `Option::unwrap()` on a `None` value");
+    commands.spawn((
+        drawable(mesh, shader),
+        AlbedoMap(0x23ae_4b5c_6ce0_d14d),
+        AlphaMap(0x691e_5a80_7372_17f2),
+        NormalMap(0xfbf3_a82f_352c_1401),
+    ));
+    let mesh = install_json_mesh(
+        root,
+        "assets/meshes/clover_flowers.json",
+        "clover_flowers",
+        meshes,
+        watch,
+    )?;
+    commands.spawn((drawable(mesh, shader), AlbedoMap(0x2bb8_1372_8bcb_5dd4)));
+    Ok(out)
+}

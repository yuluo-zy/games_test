     #[test]
+    fn prefab_spawn_event_retains_every_placement_word_across_event_buffers() {
+        use bevy_ecs::event::Events;
+        use glam::Vec2;
+        assert_eq!(core::mem::size_of::<SpawnPrefabCmd>(), 72);
+        assert_eq!(core::mem::size_of::<DespawnPrefabCmd>(), 8);
+        let placement = PlacementDataSsbo {
+            position: Vec3::new(-0.0, 123.0, -45.0),
+            scale: f32::from_bits(0x7fc0_0123),
+            rotation_angle: -17.0,
+            id: -999,
+            custom0: 0x3f80_0000,
+            custom1: 0xdead_beef,
+            anim_t_packed: 0x1234_5678,
+            bend_vector: Vec2::new(f32::from_bits(0xffc0_0456), -0.0),
+            pad0: -321,
+        };
+        let entity = Entity::from_raw(41);
+        let mut events = Events::<SpawnPrefabCmd>::default();
+        let mut reader = events.get_cursor();
+        events.send(SpawnPrefabCmd {
+            prefab_name: Some(PrefabName::new("Oak")),
+            entity: Some(entity),
+            placement,
+        });
+        events.update();
+        let cmd = reader.read(&events).next().unwrap().clone();
+        assert_eq!(cmd.entity, Some(entity));
+        assert_eq!(cmd.prefab_name, Some(PrefabName::new("Oak")));
+        assert_eq!(
+            bytemuck::bytes_of(&cmd.placement),
+            bytemuck::bytes_of(&placement)
+        );
+        assert!(reader.read(&events).next().is_none());
+    }

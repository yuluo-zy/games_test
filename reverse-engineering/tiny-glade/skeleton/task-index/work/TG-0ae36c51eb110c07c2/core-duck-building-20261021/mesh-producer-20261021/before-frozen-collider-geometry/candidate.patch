+#[cfg(test)]
+mod stair_collider_geometry_tests {
+    use super::*;
+    use country_core::systems::collision::world::RaycastMeshData;
+    use glam::Vec4;
+
+    #[test]
+    fn actual_convex_and_both_ordered_render_streams_preserve_existing_prefixes() {
+        let positions = [Vec3::new(0.0, 1.0, 0.0), Vec3::new(0.0, 2.0, 2.0)];
+        let mut colliders = Vec::new();
+        let mut rt = vec![Vec3::splat(99.0)];
+        let mut floors = vec![Vec4::splat(88.0)];
+        gen_stairs_collider_and_rt_geo(&positions, &[Vec2::Y; 2], &[2.0; 2], 1,
+            &mut colliders, &mut rt, &mut floors);
+        assert_eq!(colliders.len(), 1);
+        let shape = colliders[0].shape.as_ref().expect("原八点应构成真实凸包");
+        let bounds = shape.compute_local_aabb();
+        assert_eq!([bounds.mins.x, bounds.mins.y, bounds.mins.z], [-1.0, 0.125, 0.0]);
+        assert_eq!([bounds.maxs.x, bounds.maxs.y, bounds.maxs.z], [1.0, 2.125, 2.0]);
+        let corners = [
+            Vec3::new(1.0, 0.125, 0.0), Vec3::new(-1.0, 0.125, 0.0),
+            Vec3::new(1.0, 1.125, 0.0), Vec3::new(-1.0, 1.125, 0.0),
+            Vec3::new(1.0, 1.125, 2.0), Vec3::new(-1.0, 1.125, 2.0),
+            Vec3::new(1.0, 2.125, 2.0), Vec3::new(-1.0, 2.125, 2.0),
+        ];
+        assert_eq!(rt[0], Vec3::splat(99.0));
+        let expected = [0, 4, 1, 1, 4, 5, 2, 3, 6, 3, 7, 6, 0, 2, 4, 2, 6, 4, 1, 5, 3, 3, 5, 7]
+            .map(|index| corners[index]);
+        assert_eq!(&rt[1..], &expected);
+        assert_eq!(floors[0], Vec4::splat(88.0));
+        assert_eq!(&floors[1..], &[corners[2].extend(1.0), corners[3].extend(1.0),
+            corners[6].extend(1.0), corners[3].extend(1.0), corners[7].extend(1.0), corners[6].extend(1.0)]);
+        gen_stairs_collider_and_rt_geo(&positions, &[Vec2::Y; 2], &[2.0; 2], 1,
+            &mut colliders, &mut rt, &mut floors);
+        assert_eq!((colliders.len(), rt.len(), floors.len()), (2, 49, 13));
+    }
+
+    #[test]
+    fn zip_uses_shortest_source_and_stride_does_not_append_an_unsampled_tail() {
+        let positions: Vec<_> = (0..6).map(|z| Vec3::new(0.0, 1.0, z as f32)).collect();
+        let mut colliders = Vec::new(); let mut rt = Vec::new(); let mut floors = Vec::new();
+        gen_stairs_collider_and_rt_geo(&positions, &[Vec2::Y; 4], &[2.0; 5], 2,
+            &mut colliders, &mut rt, &mut floors);
+        assert_eq!((colliders.len(), rt.len(), floors.len()), (1, 24, 6));
+        assert_eq!(floors.iter().map(|point| point.z).fold(f32::NEG_INFINITY, f32::max), 2.0);
+        gen_stairs_collider_and_rt_geo(&positions, &[Vec2::Y; 6], &[2.0; 6], 4,
+            &mut colliders, &mut rt, &mut floors);
+        assert_eq!((colliders.len(), rt.len(), floors.len()), (2, 48, 12));
+        assert_eq!(floors[6..].iter().map(|point| point.z).fold(f32::NEG_INFINITY, f32::max), 4.0);
+        gen_stairs_collider_and_rt_geo(&positions, &[Vec2::Y; 1], &[2.0; 6], 1,
+            &mut colliders, &mut rt, &mut floors);
+        assert_eq!((colliders.len(), rt.len(), floors.len()), (2, 48, 12));
+    }
+
+    #[test]
+    fn zero_stride_panics_before_touching_any_output_even_for_empty_input() {
+        let mut colliders: Vec<RaycastMeshData> = Vec::new();
+        let mut rt = vec![Vec3::X]; let mut floors = vec![Vec4::ONE];
+        let panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(||
+            gen_stairs_collider_and_rt_geo(&[], &[], &[], 0, &mut colliders, &mut rt, &mut floors)));
+        assert!(panic.is_err());
+        assert!(colliders.is_empty()); assert_eq!(rt, vec![Vec3::X]); assert_eq!(floors, vec![Vec4::ONE]);
+    }
+
+    #[test]
+    fn degenerate_convex_failure_preserves_the_preceding_two_real_writes() {
+        let mut colliders = Vec::new(); let mut rt = vec![Vec3::X]; let mut floors = vec![Vec4::ONE];
+        gen_stairs_collider_and_rt_geo(&[Vec3::ZERO; 2], &[Vec2::X; 2], &[0.0; 2], 1,
+            &mut colliders, &mut rt, &mut floors);
+        assert!(colliders.is_empty());
+        assert_eq!((rt.len(), floors.len()), (25, 7));
+        assert_eq!(rt[0], Vec3::X); assert_eq!(floors[0], Vec4::ONE);
+        assert!(floors[1..].iter().all(|point| point.w == 1.0));
+    }
+
+    #[test]
+    fn turning_and_negative_widths_keep_each_original_endpoint_geometry() {
+        let positions = [Vec3::new(2.0, 4.0, 6.0), Vec3::new(-3.0, 7.0, 9.0)];
+        let corners = stair_collider_prism(positions, [Vec2::X, Vec2::Y], [4.0, -2.0]);
+        assert_eq!(corners[0], Vec3::new(2.0, 3.125, 4.0));
+        assert_eq!(corners[1], Vec3::new(2.0, 3.125, 8.0));
+        assert_eq!(corners[2], Vec3::new(2.0, 4.125, 4.0));
+        assert_eq!(corners[4], Vec3::new(-4.0, 6.125, 9.0));
+        assert_eq!(corners[5], Vec3::new(-2.0, 6.125, 9.0));
+        assert_eq!(corners[7], Vec3::new(-2.0, 7.125, 9.0));
+    }
+
+    #[test]
+    fn raw_nonfinite_width_and_explicit_positive_zero_are_not_erased() {
+        let points = stair_collider_prism([Vec3::ZERO; 2], [Vec2::X; 2], [f32::INFINITY, f32::NAN]);
+        assert!(points.iter().all(|point| point.y.is_nan()));
+        assert!(points[0].x.is_nan()); assert!(points[1].x.is_nan());
+        let zeros = stair_collider_prism([Vec3::new(-0.0, 0.0, -0.0); 2], [Vec2::ZERO; 2], [0.0; 2]);
+        assert_eq!(zeros[1].x.to_bits(), (-0.0_f32).to_bits());
+        assert_eq!(zeros[3].x.to_bits(), 0.0_f32.to_bits());
+        assert_eq!(zeros[1].z.to_bits(), 0.0_f32.to_bits());
+        assert_eq!(zeros[3].z.to_bits(), 0.0_f32.to_bits());
+    }

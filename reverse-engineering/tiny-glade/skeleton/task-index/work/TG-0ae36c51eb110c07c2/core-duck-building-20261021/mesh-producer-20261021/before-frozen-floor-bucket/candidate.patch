+#[cfg(test)]
+mod stair_floor_bucket_tests {
+    use super::floor_tri_count_to_atlas_idx;
+
+    #[test]
+    fn all_native_meshlet_triangle_counts_select_the_original_five_buckets() {
+        for (range, expected) in [(0..=4, 0), (5..=8, 1), (9..=16, 2), (17..=32, 3), (33..=64, 4)] {
+            for count in range {
+                assert_eq!(floor_tri_count_to_atlas_idx(count), expected, "triangle count {count}");
+            }
+        }
+    }
+
+    #[test]
+    fn integer_bucket_math_preserves_zero_and_larger_unsigned_boundaries() {
+        assert_eq!(floor_tri_count_to_atlas_idx(0), 0);
+        assert_eq!(floor_tri_count_to_atlas_idx(1), 0);
+        assert_eq!(floor_tri_count_to_atlas_idx(65), 5);
+        assert_eq!(floor_tri_count_to_atlas_idx(128), 5);
+        assert_eq!(floor_tri_count_to_atlas_idx(129), 6);
+        assert_eq!(floor_tri_count_to_atlas_idx(u32::MAX), 30);
+    }
+}

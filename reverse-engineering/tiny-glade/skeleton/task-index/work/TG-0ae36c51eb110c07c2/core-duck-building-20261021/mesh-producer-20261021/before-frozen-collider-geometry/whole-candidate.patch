+/// 原游戏回调的八顶点构造；保留宽度乘法、左右Y关联与显式+0。
+fn stair_collider_prism(positions: [Vec3; 2], tangents: [Vec2; 2], widths: [f32; 2]) -> [Vec3; 8] {
+    let mut points = [Vec3::ZERO; 8];
+    for index in 0..2 {
+        let position = positions[index];
+        let tangent = tangents[index];
+        let width = widths[index];
+        let dx = (-tangent.y * width) * 0.5;
+        let dy = (0.0 * width) * 0.5;
+        let dz = (tangent.x * width) * 0.5;
+        let base_y = if index == 0 { position.y + -0.375 } else { -0.375 + position.y };
+        let left = Vec3::new(position.x - dx, base_y - dy, position.z - dz);
+        let right = Vec3::new(position.x + dx, dy + base_y, position.z + dz);
+        points[index * 4] = Vec3::new(left.x, left.y + -0.5, left.z);
+        points[index * 4 + 1] = Vec3::new(right.x, -0.5 + right.y, right.z);
+        points[index * 4 + 2] = Vec3::new(left.x + 0.0, left.y + 0.5, left.z + 0.0);
+        points[index * 4 + 3] = Vec3::new(right.x + 0.0, right.y + 0.5, right.z + 0.0);
+    }
+    points
 }
 

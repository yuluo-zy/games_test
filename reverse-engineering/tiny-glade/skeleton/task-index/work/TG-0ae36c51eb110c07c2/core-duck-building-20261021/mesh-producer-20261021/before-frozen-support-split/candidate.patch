-/// 0x1407d94a0（O 结构）：段分割为支撑/非支撑子段。
+/// B 0x1407d94a0：以真实墙碰撞查询切分带共享边界的支撑区间。
+/// 三项输出依次为不支撑区间、支撑区间、每条支撑区间的侧距样本。
+#[allow(clippy::type_complexity)]
 pub fn split_segment_into_supported_and_unsupported_subsegments(
-    _segment: &[(Vec2, f32)],
-) -> Vec<(usize, usize)> {
-    Vec::new() // U。
+    world: &RaycastWorld,
+    _signifiers: &country_core::systems::ui::signifiers::signifier_create::UiSignifierStream,
+    positions: &[Vec3],
+    tangents: &[Vec2],
+    widths: &[f32],
+    wall_anchor: &country_core::resources::stairs::stairs_assembly_params::StairWallAnchor,
+) -> (Vec<(usize, usize)>, Vec<(usize, usize)>, Vec<Vec<f32>>) {
+    let mut unsupported = Vec::new();
+    let mut supported = Vec::new();
+    // 原先读宽度首元素，不能以 positions 的整体长度校验改变失败次序。
+    let mut side_distances = vec![vec![widths[0] * 0.5]];
+    let end = positions.len().wrapping_sub(1);
+    let mut is_supported = true;
+    let mut supported_start = 0;
+    let mut unsupported_start = 0;
+
+    for i in 1..end {
+        let normal = wall_anchor.wall_normal();
+        let tangent = tangents[i];
+        let sign = if normal.y * tangent.x > normal.x * tangent.y { -1.0 } else { 1.0 };
+        let raw = Vec3::new(-tangent.y, 0.0, tangent.x) * sign;
+        let inverse_length = 1.0 / ((raw.y * raw.y + raw.x * raw.x) + raw.z * raw.z).sqrt();
+        let direction = if inverse_length.is_finite() && inverse_length > 0.0 {
+            raw * inverse_length
+        } else {
+            Vec3::ZERO
+        };
+        let point = positions[i];
+        let width = widths[i];
+        let origin = Vec3::new(
+            (direction.x * width) * -0.5 + point.x,
+            (direction.y * width) * -0.5 + (point.y + f32::from_bits(0xbf95_c28f)),
+            (direction.z * width) * -0.5 + point.z,
+        );
+        let result = world.raycast_simple_with_max_toi(
+            origin, direction, f32::from_bits(0x3fe3_d70a), 1,
+        );
+        if result.is_miss() {
+            if is_supported {
+                supported.push((supported_start, i - 1));
+                unsupported_start = i - 1;
+                is_supported = false;
+            }
+        } else {
+            let dz = origin.z - result.position.z;
+            let dx = origin.x - result.position.x;
+            let distance = width * -0.5 + (dz * dz + dx * dx).sqrt();
+            if is_supported {
+                side_distances.last_mut().unwrap().push(distance);
+            } else {
+                unsupported.push((unsupported_start, i));
+                side_distances.push(vec![distance]);
+                supported_start = i;
+                is_supported = true;
+            }
+        }
+    }
+    if is_supported {
+        supported.push((supported_start, end));
+        // 原取宽度 Vec 的真实末项，不用 points[end] 对齐索引替代。
+        side_distances.last_mut().unwrap().push(*widths.last().unwrap() * 0.5);
+    } else {
+        unsupported.push((unsupported_start, end));
+    }
+    (unsupported, supported, side_distances)
 }
 

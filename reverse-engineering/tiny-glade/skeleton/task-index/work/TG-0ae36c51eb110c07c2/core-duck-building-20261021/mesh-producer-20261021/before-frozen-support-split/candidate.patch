+#[cfg(test)]
+mod supported_segment_tests {
+    use super::*;
+    use country_core::resources::stairs::stairs_assembly_params::StairWallAnchor;
+    use country_core::resources::walls::WallId;
+    use country_core::systems::collision::world::{
+        upsert_collider, ColliderMeshInstance, ColliderUpsert, RaycastGeoSource, RaycastMeshData,
+    };
+    use country_core::systems::ui::signifiers::signifier_create::UiSignifierStream;
+    use std::{collections::HashMap, sync::Arc};
+
+    fn points(count: usize) -> Vec<Vec3> {
+        (0..count).map(|i| Vec3::new(i as f32 * 4.0, -f32::from_bits(0xbf95_c28f), 0.0)).collect()
+    }
+
+    fn wall_world(sample_indices: &[usize], source: RaycastGeoSource) -> RaycastWorld {
+        let mut world = RaycastWorld::new();
+        let mut registry = HashMap::<usize, ColliderMeshInstance>::new();
+        for &i in sample_indices {
+            let result = upsert_collider(
+                &mut world, &mut registry, i, source,
+                Arc::new(RaycastMeshData::new_cuboid_at(Vec3::new(0.5, 2.0, 0.2), Vec3::ZERO)),
+                Vec3::new(i as f32 * 4.0, 0.0, 0.5), glam::Quat::IDENTITY,
+            );
+            assert!(matches!(result, ColliderUpsert::Inserted { .. }));
+        }
+        world.flush_colliders();
+        world
+    }
+
+    fn split(world: &RaycastWorld, positions: &[Vec3], tangents: &[Vec2], widths: &[f32])
+        -> (Vec<(usize, usize)>, Vec<(usize, usize)>, Vec<Vec<f32>>)
+    {
+        split_segment_into_supported_and_unsupported_subsegments(
+            world, &UiSignifierStream::default(), positions, tangents, widths,
+            &StairWallAnchor::new(WallId(0xabcd), 0.0),
+        )
+    }
+
+    fn assert_distances(actual: &[f32], expected: &[f32]) {
+        assert_eq!(actual.len(), expected.len());
+        for (&actual, &expected) in actual.iter().zip(expected) {
+            assert!((actual - expected).abs() < 1e-6, "{actual} != {expected}");
+        }
+    }
+
+    #[test]
+    fn real_wall_hits_keep_one_supported_span_and_actual_side_distances() {
+        let world = wall_world(&[1, 2, 3], RaycastGeoSource::Slot0);
+        let (unsupported, supported, distances) = split(&world, &points(5), &[Vec2::X; 5], &[2.0; 5]);
+        assert!(unsupported.is_empty());
+        assert_eq!(supported, [(0, 4)]);
+        assert_eq!(distances.len(), 1);
+        assert_distances(&distances[0], &[1.0, 0.4, 0.4, 0.4, 1.0]);
+    }
+
+    #[test]
+    fn all_misses_retain_the_initial_zero_length_supported_boundary() {
+        let world = wall_world(&[], RaycastGeoSource::Slot0);
+        let (unsupported, supported, distances) = split(&world, &points(5), &[Vec2::X; 5], &[2.0; 5]);
+        assert_eq!(unsupported, [(0, 4)]);
+        assert_eq!(supported, [(0, 0)]);
+        assert_eq!(distances, [vec![1.0]]);
+    }
+
+    #[test]
+    fn hit_miss_hit_keeps_shared_boundaries_and_corresponding_width_runs() {
+        let world = wall_world(&[1, 3], RaycastGeoSource::Slot0);
+        let (unsupported, supported, distances) = split(&world, &points(5), &[Vec2::X; 5], &[2.0; 5]);
+        assert_eq!(unsupported, [(1, 3)]);
+        assert_eq!(supported, [(0, 1), (3, 4)]);
+        assert_eq!(distances.len(), 2);
+        assert_distances(&distances[0], &[1.0, 0.4]);
+        assert_distances(&distances[1], &[0.4, 1.0]);
+    }
+
+    #[test]
+    fn non_wall_subworld_is_excluded_by_the_original_mask() {
+        let world = wall_world(&[1], RaycastGeoSource::Slot1);
+        let (unsupported, supported, distances) = split(&world, &points(3), &[Vec2::X; 3], &[2.0; 3]);
+        assert_eq!(unsupported, [(0, 2)]);
+        assert_eq!(supported, [(0, 0)]);
+        assert_eq!(distances, [vec![1.0]]);
+    }
+
+    #[test]
+    fn endpoints_are_not_queried_and_final_width_uses_the_actual_last_element() {
+        let world = wall_world(&[0, 1], RaycastGeoSource::Slot0);
+        let one = split(&world, &points(1), &[], &[2.0, 8.0]);
+        assert_eq!(one, (vec![], vec![(0, 0)], vec![vec![1.0, 4.0]]));
+        let two = split(&world, &points(2), &[], &[2.0, 4.0, 10.0]);
+        assert_eq!(two, (vec![], vec![(0, 1)], vec![vec![1.0, 5.0]]));
+    }
+
+    #[test]
+    fn zero_nan_and_infinite_tangents_use_zero_direction_in_the_same_real_world() {
+        let world = wall_world(&[1], RaycastGeoSource::Slot0);
+        assert!(split(&world, &points(3), &[Vec2::X; 3], &[2.0; 3]).0.is_empty());
+        for tangent in [Vec2::ZERO, Vec2::splat(f32::NAN), Vec2::splat(f32::INFINITY)] {
+            let (_, supported, distances) = split(&world, &points(3), &[tangent; 3], &[2.0; 3]);
+            assert_eq!(supported, [(0, 0)]);
+            assert_eq!(distances, [vec![1.0]]);
+        }
+    }
+
+    fn panic_text(f: impl FnOnce()) -> String {
+        let panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).unwrap_err();
+        panic.downcast_ref::<String>().cloned()
+            .or_else(|| panic.downcast_ref::<&str>().map(|s| (*s).to_owned())).unwrap()
+    }
+
+    #[test]
+    fn bounds_fail_in_original_width_then_tangent_then_point_order() {
+        let world = RaycastWorld::new();
+        let first = panic_text(|| { split(&world, &[], &[], &[]); });
+        assert!(first.contains("the len is 0 but the index is 0"));
+        let tangent = panic_text(|| { split(&world, &[], &[Vec2::X], &[2.0, 2.0]); });
+        assert!(tangent.contains("the len is 1 but the index is 1"));
+        let point = panic_text(|| { split(&world, &[], &[Vec2::X; 2], &[2.0, 2.0]); });
+        assert!(point.contains("the len is 0 but the index is 1"));
+        let width = panic_text(|| { split(&world, &points(3), &[Vec2::X; 3], &[2.0]); });
+        assert!(width.contains("the len is 1 but the index is 1"));
+    }
+}

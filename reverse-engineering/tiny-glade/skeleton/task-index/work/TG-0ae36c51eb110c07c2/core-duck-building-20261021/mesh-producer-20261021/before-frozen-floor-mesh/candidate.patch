+/// 同一原函数的 CPU 几何区；输入短切片保最短 zip，不补首尾样本。
+fn stair_floor_geometry(
+    widths: &[f32],
+    tangents: &[Vec2],
+    positions: &[Vec3],
+    roof_heights: [Option<f32>; 2],
+    auxiliary_samples: &[f32],
+) -> (Vec<u32>, Vec<Vec3>, Vec<Vec3>) {
+    let start_raise = roof_heights[0].map_or(0.0, |h| (0.15 - h).max(0.0));
+    let end_raise = roof_heights[1].map_or(0.0, |h| (0.15 - h).max(0.0));
+    let inverse_end = 1.0 / positions.len().wrapping_sub(1) as f32;
+    let raised: Vec<_> = positions.iter().enumerate().map(|(i, &point)| {
+        let u = i as f32 * inverse_end;
+        let height = (1.0 - u) * start_raise + u * end_raise;
+        // 不能只赋值 Y；原 callback 的 X/Z 也有 +0*height 运算。
+        point + Vec3::Y * height
+    }).collect();
+    let mut source_normals = Vec::with_capacity(raised.len());
+    let first_delta = raised[1] - raised[0];
+    source_normals.push(stair_floor_normal(first_delta));
+    for i in 1..raised.len() - 1 {
+        source_normals.push(stair_floor_normal(raised[i + 1] - raised[i - 1]));
+    }
+    source_normals.push(stair_floor_normal(raised[raised.len() - 2] - raised[raised.len() - 1]));
+
+    let mut indices = Vec::with_capacity(raised.len() * 12);
+    let mut vertices = Vec::with_capacity(raised.len() * 4);
+    let mut normals = Vec::with_capacity(raised.len() * 4);
+    // 原在进入 zip 前读取 aux[0]；width/tangent 空不能绕过此失败。
+    let mut previous_gap = 0.15 - auxiliary_samples[0];
+    let mut previous_left = Vec3::ZERO;
+    let mut previous_right = Vec3::ZERO;
+    let mut previous_normal = Vec3::ZERO;
+    let mut top_pair = [0; 2];
+    let mut bottom_pair = [0; 2];
+    let mut active = false;
+    for ((((&width, tangent), point), normal), &sample) in widths.iter().zip(tangents)
+        .zip(&raised).zip(&source_normals).zip(auxiliary_samples)
+    {
+        let gap = 0.15 - sample;
+        let next_active = gap > 0.0;
+        let offset = (Vec3::new(-tangent.y, 0.0, tangent.x) * width) * 0.5;
+        let left = *point - offset;
+        let right = offset + *point;
+        if (previous_gap > 0.0) != next_active {
+            let u = previous_gap / (previous_gap - gap);
+            let one_minus = 1.0 - u;
+            let boundary_left = left * u + previous_left * one_minus;
+            let boundary_right = right * u + previous_right * one_minus;
+            let boundary_normal = *normal * u + previous_normal * one_minus;
+            append_stair_floor_pair(
+                &mut indices, &mut vertices, &mut normals, &mut top_pair,
+                [boundary_left, boundary_right], boundary_normal, active, next_active,
+            );
+            append_stair_floor_pair(
+                &mut indices, &mut vertices, &mut normals, &mut bottom_pair,
+                [stair_floor_bottom(boundary_right), stair_floor_bottom(boundary_left)],
+                -boundary_normal, active, next_active,
+            );
+            active = next_active;
+        }
+        if next_active {
+            append_stair_floor_pair(
+                &mut indices, &mut vertices, &mut normals, &mut top_pair,
+                [left, right], *normal, active, true,
+            );
+            append_stair_floor_pair(
+                &mut indices, &mut vertices, &mut normals, &mut bottom_pair,
+                [stair_floor_bottom(right), stair_floor_bottom(left)], -(*normal), active, true,
+            );
+            active = true;
+        }
+        previous_gap = gap;
+        previous_left = left;
+        previous_right = right;
+        previous_normal = *normal;
+    }
+    (indices, vertices, normals)
 }
 
+fn stair_floor_normal(delta: Vec3) -> Vec3 {
+    // 原先归一化，再取负；零/溢出回退留下三个负零，不能交换负号与回退。
+    -delta.cross(Vec3::new(-delta.z, 0.0, delta.x)).normalize_or_zero()
+}
+
+fn stair_floor_bottom(point: Vec3) -> Vec3 {
+    Vec3::new(point.x, point.y + f32::from_bits(0xbe4c_cccd), point.z)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn append_stair_floor_pair(
+    indices: &mut Vec<u32>,
+    vertices: &mut Vec<Vec3>,
+    normals: &mut Vec<Vec3>,
+    previous: &mut [u32; 2],
+    pair: [Vec3; 2],
+    normal: Vec3,
+    connect: bool,
+    remember: bool,
+) {
+    let index = vertices.len() as u32;
+    let next_index = index.wrapping_add(1);
+    if connect {
+        indices.extend_from_slice(&[
+            previous[0], previous[1], index, index, previous[1], next_index,
+        ]);
+    }
+    vertices.extend_from_slice(&pair);
+    normals.extend_from_slice(&[normal, normal]);
+    if remember { *previous = [index, next_index]; }
+}

+    #[derive(Default)]
+    struct RecordDevice {
+        created: Mutex<Vec<(BufferDesc, String, Vec<u8>)>>,
+        released: Mutex<Vec<u64>>,
+        fail: bool,
+    }
+    impl GraphicsDevice for RecordDevice {
+        fn create_buffer(&self, desc: &BufferDesc, name: &str, bytes: Option<&[u8]>) -> Result<Buffer, BackendError> {
+            let mut calls = self.created.lock().unwrap();
+            calls.push((*desc, name.to_owned(), bytes.unwrap().to_vec()));
+            if self.fail { return Err(BackendError::unsupported("floor upload fixture failure")); }
+            Ok(Buffer { id: calls.len() as u64, byte_size: desc.size as u64, ..Default::default() })
+        }
+        fn update_buffer_bytes(&self, _: &Buffer, _: &[u8], _: &[Range<usize>], _: usize) -> Result<(), BackendError> {
+            panic!("Trimesh creates its packed buffer in one call")
+        }
+        fn device_address(&self, buffer: &Buffer) -> u64 { 0xabcd_0000 + buffer.id * 0x10000 }
+        fn release_buffer(&self, buffer: &Buffer) { self.released.lock().unwrap().push(buffer.id); }
+    }
+
+    fn publish(world: &mut World, device: Arc<RecordDevice>, count: usize, auxiliary: f32, entities: &mut Vec<Entity>) {
+        let mut queue = bevy_ecs::world::CommandQueue::default();
+        {
+            let mut commands = Commands::new(&mut queue, world);
+            gen_stair_floors(device, &vec![2.0; count], &vec![Vec2::X; count], &line(count),
+                entities, &mut commands, 0xfedc_ba98, [None, None], &vec![auxiliary; count]);
+        }
+        queue.apply(world);
+    }

+/// B 0x1407dc170：发布经过屋顶补高与辅助高度裁切的双面楼梯网格。
+/// 复用真实 Trimesh 打包器；每个 chunk 的实体共享同一块有析构责任的缓冲。
+#[allow(clippy::too_many_arguments)]
+pub fn gen_stair_floors<D>(
+    device: std::sync::Arc<D>,
+    widths: &[f32],
+    tangents: &[Vec2],
+    positions: &[Vec3],
+    entities: &mut Vec<Entity>,
+    commands: &mut Commands<'_, '_>,
+    info_28: u32,
+    roof_heights: [Option<f32>; 2],
+    auxiliary_samples: &[f32],
+) where
+    D: country_core::render::ssbo::rhapsody_boundary::GraphicsDevice + Send + Sync + 'static,
+{
+    use country_core::components::drawable::{NaniBundle, NaniInstanceDesc, NaniInstanceMeshDesc};
+    use country_core::render::nani::{
+        gpu_world::{GpuWorldSubsetKind, InstanceDataMarker},
+        instance_data::StairsFloorInstanceData,
+        trimesh::Trimesh,
+    };
+    use country_core::resources::stairs::visual::{StairsFloorMeshChunk, StairsMeshBuffer};
+    use country_core::utils::components::transform::Transform;
+    use std::sync::Arc;
+
+    let (indices, vertices, normals) = stair_floor_geometry(
+        widths, tangents, positions, roof_heights, auxiliary_samples,
+    );
+    match Trimesh::builder(&indices).positions(&vertices).attrib(&normals)
+        .build(device.as_ref(), "stair floor chunk")
+    {
+        Ok(mesh) => {
+            let buffer = Arc::new(StairsMeshBuffer::new(mesh.buffer, device));
+            for chunk in mesh.chunks {
+                let bucket = floor_tri_count_to_atlas_idx(u32::from(chunk.index_count()) / 3);
+                let entity = commands.spawn((
+                    NaniBundle::<StairsFloorInstanceData> {
+                        desc: NaniInstanceDesc {
+                            mesh: NaniInstanceMeshDesc::AtlasPart(bucket),
+                            subset_kind: GpuWorldSubsetKind::StairsFloor,
+                        },
+                        transform: Transform::identity(),
+                        marker: InstanceDataMarker::default(),
+                    },
+                    StairsFloorMeshChunk { buffer: Arc::clone(&buffer), chunk, info_28 },
+                )).id();
+                entities.push(entity);
+            }
+        }
+        Err(error) => {
+            // 原 dd980 先按 Error 级别过滤，记录 Display，再析构错误并结束。
+            log::error!(target: "system_decorator::decorator_visual::stairs_assemble",
+                "Error spawning stair mesh: {}", error);
+        }
+    }
+}

+    #[test]
+    fn multiple_real_meshlets_share_one_buffer_until_the_last_entity_is_removed() {
+        let device = Arc::new(RecordDevice::default());
+        let mut world = World::new();
+        let mut entities = Vec::new();
+        publish(&mut world, device.clone(), 70, 0.0, &mut entities);
+        assert!(entities.len() > 1);
+        let first = world.get::<StairsFloorMeshChunk>(entities[0]).unwrap();
+        let weak = Arc::downgrade(&first.buffer);
+        for &entity in &entities {
+            let chunk = world.get::<StairsFloorMeshChunk>(entity).unwrap();
+            assert!(Arc::ptr_eq(&first.buffer, &chunk.buffer));
+            assert_eq!(world.get::<NaniInstanceDesc>(entity).unwrap().mesh,
+                NaniInstanceMeshDesc::AtlasPart(floor_tri_count_to_atlas_idx(u32::from(chunk.chunk.index_count()) / 3)));
+        }
+        assert_eq!(device.created.lock().unwrap().len(), 1);
+        for &entity in &entities[..entities.len() - 1] { assert!(world.despawn(entity)); }
+        assert!(device.released.lock().unwrap().is_empty());
+        assert!(weak.upgrade().is_some());
+        assert!(world.despawn(*entities.last().unwrap()));
+        assert!(weak.upgrade().is_none());
+        assert_eq!(*device.released.lock().unwrap(), [1]);
+    }

+    fn destination_sentinel() -> DecoratorInfo {
+        DecoratorInfo {
+            dst_wall: 0x1716_1514_1312_1110,
+            dst_secondary: 0x1f1e_1d1c_1b1a_1918,
+            dst_payload: 0x2726_2524_2322_2120,
+            u18: 0x2f2e_2d2c_2b2a_2928,

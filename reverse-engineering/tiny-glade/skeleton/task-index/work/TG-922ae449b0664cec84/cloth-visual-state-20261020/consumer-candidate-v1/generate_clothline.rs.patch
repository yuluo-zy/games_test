+fn relative_height(u: f32, y0: f32, y1: f32, distance: f32) -> f32 {
+    let centered = u + u - 1.0;
+    ((u * y1 + (1.0 - u) * y0) - y0) + (((1.0 - centered * centered) * distance) * (-0.08))
+}
+fn emit_plan(
+    plan: &ConnectionPlan,
+    commands: &mut Commands,
+    meshes: &AssetMeshLibrary,
+    shaders: &AssetShaderLibrary,
+    transient: &mut DecoratorTransientVisualState,
+) {
+    emit_beam(commands, plan.id_a, plan.a, transient);
+    emit_beam(commands, plan.id_b, plan.b, transient);
+    let a = plan.a.translation + plan.a.rotation * Vec3::new(0.0, 0.0, 0.2);
+    let b = plan.b.translation + plan.b.rotation * Vec3::new(0.0, 0.0, 0.2);
+    let delta = b - a;
+    let distance = delta.length();
+    let rng = fastrand::Rng::with_seed(utils::rng::init_rng(plan.id_a.0.wrapping_mul(plan.id_b.0)));
+    let rounded = (distance / 0.7).round() as usize;
+    let count = rounded
+        .wrapping_add(1)
+        .wrapping_add(usize::from(rounded == 0));
+    let boundaries = utils::random_splits(count, 0.2 / distance, &rng);
+    let horizontal = (delta.x * delta.x + delta.z * delta.z).sqrt();
+    let rotation_input = Vec2::new(-delta.z, delta.x) / horizontal;
+    for (index, pair) in boundaries.windows(2).enumerate() {
+        let middle = (pair[0] + pair[1]) * 0.5;
+        let span = (pair[1] - pair[0]) * f32::from_bits(0x3f36_db6e);
+        let left = relative_height(middle - span * 0.5, a.y, b.y, distance);
+        let right = relative_height(middle + span * 0.5, a.y, b.y, distance);
+        let height = (left + right) * 0.5;
+        let factor = (distance * span).abs() * 2.5;
+        let second_variant = rng.u32(..) & 0xc000_0000 == 0;
+        let r1 = rng.f32();
+        let r2 = rng.f32();
+        let scale = Vec3::new(
+            (r2 * 1.1 + (1.0 - r2) * 0.8).min(0.8) * factor,
+            (((1.0 - r1) * 0.6 + r1 * 1.2) * factor).min(1.0),
+            1.0,
+        );
+        let position = Vec3::new(
+            (1.0 - middle) * a.x + middle * b.x,
+            a.y + height,
+            (1.0 - middle) * a.z + middle * b.z,
+        );
+        let rotation = utils::xz_rotation_bad(rotation_input);
+        let mut builder = WindowVisualEntityBuilder::new(position, rotation, plan.id_a.0);
+        builder.mesh_name = if second_variant {
+            CLOTH_MESH_2
+        } else {
+            CLOTH_MESH
+        };
+        builder.nani_name = "nani_cloth";
+        builder.scale_override = Some(scale);
+        builder.normal_map = Some(if second_variant { NORMAL_2 } else { NORMAL });
+        builder.clothline(ClothlineCloth::from_words([
+            (left - height).to_bits(),
+            (right - height).to_bits(),
+            plan.word.wrapping_add(index as u32),
+        ]));
+        builder.build(commands, plan.id_a.0, meshes, shaders, transient);
+    }
+    clothline(
+        &mut ClothlineContext {
+            commands,
+            meshes,
+            shaders,
+            transient,
+        },
+        plan.id_a.0,
+        a,
+        b,
+        f32::from_bits(0x3e99_999a),
+        0.0,
+        1.0,
+    );
+}

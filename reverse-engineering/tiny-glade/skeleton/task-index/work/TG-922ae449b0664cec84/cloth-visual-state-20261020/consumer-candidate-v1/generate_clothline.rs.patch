+        assert_eq!(state.cloth_infos.len(), 1);
+        assert_eq!(
+            state.persistent_entities_of(37),
+            Some([persistent].as_slice())
+        );
+        let entities = state.transient.entities_of(37).unwrap().to_vec();
+        assert!(entities.len() > 4);
+        assert_eq!(
+            mesh_desc(&world, entities[0]).mesh,
+            NaniMeshSelector::Named(BEAM_NAME)
+        );
+        assert_eq!(
+            mesh_desc(&world, entities[1]).mesh,
+            NaniMeshSelector::Named(BEAM_NAME)

+fn plans_and_cache(
+    projected: &[ClothInfo],
+    graph: &ConnectResult,
+    cache: &mut CacheClothes,
+    storage: &DecoratorStorage,
+    sound: &mut EventWriter<PlayClutterSoundCmd>,
+) -> Vec<ConnectionPlan> {
+    let mut plans = Vec::new();
+    cache.current_pairs.clear();
+    for &(ia, ib) in &graph.edges {
+        let a = &projected[ia];
+        let b = &projected[ib];
+        let pair = if a.decorator_id.0 <= b.decorator_id.0 {
+            (a.decorator_id, b.decorator_id)
+        } else {
+            (b.decorator_id, a.decorator_id)
+        };
+        cache.current_pairs.insert(pair);
+        if !cache.previous_pairs.contains(&pair) {
+            let pa = a.transform.translation;
+            let pb = b.transform.translation;
+            sound.write(PlayClutterSoundCmd {
+                kind: 16,
+                context: 0,
+                position: Vec3::new(
+                    pa.x * 0.5 + pb.x * 0.5,
+                    pa.y * 0.5 + pb.y * 0.5,
+                    pa.z * 0.5 + pb.z * 0.5,
+                ),
+            });
+        }
+        plans.push(connected_plan(a, b, storage));
+    }
+    // Preserve this transition before degree-zero plans and all Commands/assets.
+    cache.previous_pairs.clone_from(&cache.current_pairs);
+    for &i in &graph.sorted_indices {
+        if graph.degrees[i] == 0 {
+            plans.push(unconnected_plan(&projected[i], storage));
+        }
+    }
+    plans
+}

+        assert_eq!(
+            world.get::<Transform>(entities[0]).unwrap().scale,
+            Vec3::new(1.3, 0.9, 1.7)
+        );
+        let mut garments = 0;
+        let mut threads = 0;
+        for entity in entities {
+            let desc = mesh_desc(&world, entity);
+            let transform = world.get::<Transform>(entity).unwrap();
+            if desc.subset_kind == GpuWorldSubsetKind::Cloth {
+                let payload = world.get::<ClothlineCloth>(entity).unwrap().words();
+                assert_eq!(payload[2], 37 + garments);
+                assert_ne!(payload, [0; 3]);
+                assert!(world
+                    .get::<InstanceDataMarker<ClothInstanceData>>(entity)

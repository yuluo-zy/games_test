+                assert!(transform.translation.is_finite());
+                assert!(transform.scale.x > 0.0 && transform.scale.y > 0.0);
+                assert_eq!(transform.scale.z, 1.0);
+                garments += 1;
+            } else if desc.mesh != NaniMeshSelector::Named(BEAM_NAME) {

+#[cfg(test)]
+mod original_forest_rectangle_tests {
+    use super::*;
+
+    #[test]
+    fn perimeter_projection_uses_native_first_edge_and_finite_search_bound() {
+        let rectangle = Rectangle2d::new_centered_axis_aligned(Vec2::splat(2.0));
+        assert_eq!(rectangle.get_closest_edge_pt_indices(Vec2::ZERO), (0, 1));
+        assert_eq!(rectangle.closest_point_on_perimeter(Vec2::ZERO), Vec2::new(-1.0, 0.0));
+        assert_eq!(rectangle.closest_point_on_perimeter(Vec2::new(5.0, 0.25)), Vec2::new(1.0, 0.25));
+        // Original starts at1000, so no faraway distance improves the pair.
+        let far = Vec2::new(0.0, 100_000.0);
+        assert_eq!(rectangle.get_closest_edge_pt_indices(far), (0, 1));
+        assert_eq!(rectangle.closest_point_on_perimeter(far), Vec2::new(-1.0, 1.0));
+    }

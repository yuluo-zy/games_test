+    /// B 0x140c9a9d0 selects the first edge whose clamped projection
+    /// strictly improves the original 1000.0 distance bound. The second
+    /// endpoint may be4; users wrap that sentinel to corner0.
+    pub fn get_closest_edge_pt_indices(self, point: Vec2) -> (usize, usize) {
+        let corners = self.as_points2();
+        let mut best = (0, 1);
+        let mut best_distance = 1000.0;
+        for i in 0..4 {
+            let a = corners[i];
+            let b = corners[(i + 1) % 4];
+            let edge = b - a;
+            let offset = point - a;
+            let denominator = (edge.y * edge.y + edge.x * edge.x).max(1e-20);
+            let t = (offset.y * edge.y + offset.x * edge.x) / denominator;
+            // MAXSS(0,t), MINSS(1,t): unordered t remains unordered.
+            let lower = if 0.0 > t { 0.0 } else { t };
+            let t = if 1.0 < lower { 1.0 } else { lower };
+            let closest = a * (1.0 - t) + b * t;
+            let d = point - closest;
+            let distance = (d.y * d.y + d.x * d.x).sqrt();
+            if best_distance > distance {
+                best = (i, i + 1);
+                best_distance = distance;
+            }
+        }
+        best
+    }

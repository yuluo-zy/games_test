+pub fn initial_stroke_desired_height(
+    mouse_index: Option<i32>,
+    on_rock: bool,
+    drag_height: f32,
+) -> f32 {
+    if mouse_index.is_some_and(|id| id != -1) && !on_rock {
+        drag_height + 1.5
+    } else {
+        drag_height
+    }

+        let mut vaos = AssetVAOLibrary::new();
+        let mut world = World::new();
+        let points = vec![Vec3::ZERO, Vec3::X];
+        let sources = [
+            SignifierMesh::Empty,
+            SignifierMesh::Points(points.clone()),
+            SignifierMesh::PointsWithColors {
+                points: points.clone(),
+                colors: vec![Vec3::Y, Vec3::Z],

+#[cfg(test)]
+mod original_forest_circle_tests {
+    use super::*;
+    #[test]
+    fn actual_occupied_cells_extend_beyond_the_nearest_segment_radius() {
+        let mut spatial = WallSpatialHash::default();
+        let id = WallId(41);
+        spatial.add_segment(WallSpatialSegment {
+            endpoints: [[0.0, 0.0], [0.0, 20.0]], source_u: [0.0, 1.0],
+            relative_heights: [1.0; 2], terrain_heights: [0.0; 2], wall: id,
+        });
+        // Original uses occupied cells + their half diagonal: this tree is
+        // eight units from the wall, yet overlaps a live nearby cell.
+        assert!(spatial.any_occupied_cell_in_circle(glam::Vec2::new(8.0, 1.0), 7.0));
+        assert!(!spatial.any_occupied_cell_in_circle(glam::Vec2::new(30.0, 1.0), 7.0));
+        spatial.remove_wall_id(id);
+        assert!(!spatial.any_occupied_cell_in_circle(glam::Vec2::new(8.0, 1.0), 7.0));
+    }

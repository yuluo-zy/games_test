+        assert!(bytes.len() as u64 >= buffer.byte_size, "assertion failed: data.len() >= buffer.buffer.desc.size");
+        assert_eq!(bytes.len() % 4, 0);
+        assert_eq!(bytes.as_ptr() as usize % 4, 0);
+        let ptr = bytes.as_mut_ptr().cast::<Self>();

+            assert_eq!((calls[index].0.size, calls[index].0.usage, calls[index].0.memory, calls[index].0.alignment), (size, 0x22, 1, 4));
+            assert_eq!(calls[index].1, name);
+            assert!(calls[index].2.is_none());
+        }

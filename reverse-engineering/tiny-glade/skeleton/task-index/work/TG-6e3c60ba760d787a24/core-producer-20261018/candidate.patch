+        library.add_new_with_data::<GroundedBuildingsSsbo>(&device, &buildings);
+        assert_eq!(library.instance_count::<LanternSsbo>(), 2);
+        assert_eq!(library.instance_count::<GroundedBuildingsSsbo>(), 3);

+/// Actual packaged AA consumers over untouched temporal allocations. Only the
+/// diagnostic current color/reprojection/depth inputs are initialized here;
+/// there is deliberately no history clear and no history import-as-initialized.
+#[test]
+fn original_taa_and_tgsr_read_first_undefined_history_then_use_real_previous_output() {
+    use country_core::systems::render_loop::{
+        compute_passes::taa::{HistoryTexture, TaaInputs, TgsrInputs},
+        render_world::formats,
+    };
+    for use_tgsr in [false, true] {
+        let Some(mut fixture) = Fixture::new() else { return; };
+        for frame_index in 0..2 {
+            fixture.world.resource_mut::<FrameConstants>().frame_counter = frame_index;
+            let device = fixture.device.clone();
+            let shaders = fixture.shaders.clone();
+            let ((readback_buffer, history_resource), built) = fixture.bridge.build_frame(|frame| {
+                tiny_glade::frame_setup::with_frame_resources(frame, &mut fixture.world, |frame, world| {
+                    let mut inputs = Vec::new();
+                    for (format, clear) in [
+                        (vk::Format::B10G11R11_UFLOAT_PACK32, [1.0, 0.0, 0.0, 1.0]),
+                        (vk::Format::R16G16B16A16_SFLOAT, [0.0; 4]),
+                        (vk::Format::R32_SFLOAT, [1.0, 0.0, 0.0, 0.0]),
+                    ] {
+                        let texture = Arc::new(rhapsody::raw::texture::Texture::new(device.clone(),
+                            &rhapsody::raw::texture::TextureDesc::new_2d(16, 16, format)
+                                .usage(vk::ImageUsageFlags::SAMPLED | vk::ImageUsageFlags::TRANSFER_DST))?);
+                        let id = frame.import_native_texture(texture.clone(), 0)?;
+                        frame.with_graph(|graph| {
+                            let device = device.clone();
+                            let mut pass = graph.add_pass("fixture current AA input");
+                            pass.add_resource_access(id, 0x34, 0)?;
+                            pass.render_with_result_context(move |ctx| {
+                                unsafe { device.device.cmd_clear_color_image(
+                                    vk::CommandBuffer::from_raw(ctx.command.handle()), texture.handle,
+                                    vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                                    &vk::ClearColorValue { float32: clear },
+                                    &[vk::ImageSubresourceRange::default()
+                                        .aspect_mask(vk::ImageAspectFlags::COLOR)
+                                        .level_count(1).layer_count(1)]); }
+                                Ok(())
+                            });
+                            Ok(())
+                        })?;
+                        inputs.push(RgTexture { resource: id.raw(),
+                            desc: TextureDesc::new_2d([16, 16], format.as_raw() as u32).sampled() });
+                    }
+                    let (pair, output) = frame.with_compute(|compute| {
+                        let desc = TextureDesc::new_2d([16, 16], formats::COLOR_HDR).sampled().storage();
+                        let pair = compute.get_or_create_temporal_texture_pair(
+                            if use_tgsr { "tgsr_history" } else { "taa_history" }, &desc)
+                            .map_err(|e| rhapsody::Error::invalid_usage(format!("AA history: {e}")))?;
+                        Ok((pair, compute.create_raw_texture("fixture actual AA output", &desc)))
+                    })?;
+                    assert_eq!(pair.fresh, frame_index != 0, "fresh is valid-history, not allocation freshness");
+                    let history = HistoryTexture { tex: pair.previous, valid: pair.fresh };
+                    let min_subgroup_size = frame.hosts().buffers.graphics_device().min_subgroup_size_option();
+                    let mut compute = scene_compute::SceneComputeHost::new(frame, world);
+                    let aa = if use_tgsr {
+                        compute.calculate_tgsr(&TgsrInputs {
+                            color: &inputs[0], reprojection: &inputs[1], depth: &inputs[2],
+                            output: &output, history_output: &pair.current, history: &history,
+                            sharpen_amount: 0.0, bypass_clamp: 0, history_global: false,
+                            min_subgroup_size,
+                        })?
+                    } else {
+                        compute.calculate_taa(&TaaInputs {
+                            color: &inputs[0], reprojection: &inputs[1], output: &output,
+                            history_output: &pair.current, history: &history,
+                            sharpen_amount: 0.0, bypass_clamp: 0, history_global: false,
+                        })?
+                    };
+                    frame.with_graph(|graph| {
+                        let accesses: Vec<_> = graph.declaration().passes.iter().flat_map(|p| &p.accesses)
+                            .filter(|a| a.resource_index == pair.previous.resource).collect();
+                        assert!(!accesses.is_empty(), "actual history remains bound and declared");
+                        assert!(accesses.iter().all(|a| !a.contents_unused));
+                        assert_eq!(accesses.iter().any(|a| a.allow_undefined_contents), frame_index == 0);
+                        let source = &graph.declaration().resources[pair.previous.resource as usize].source;
+                        if frame_index == 0 {
+                            assert!(matches!(source,
+                                rhapsody::rg::graph::OriginSource::ImportOwned { initial_access: 0, .. }
+                                | rhapsody::rg::graph::OriginSource::ImportUnowned { initial_access: 0, .. }));
+                        }
+                        Ok(())
+                    })?;
+                    let buffer = readback(frame, world, &shaders, &device, aa)?;
+                    Ok((buffer, pair.previous.resource))
+                })
+            }).unwrap();
+            fixture.bridge.shader_backend().prewarm(Duration::from_secs(30)).unwrap();
+            let receipt = fixture.bridge.execute_built(built).unwrap();
+            if use_tgsr {
+                for required in ["TGSR blur lum", "TGSR reproject", "TGSR"] {
+                    assert!(receipt.snapshot.pass_order.iter().any(|p| p == required), "missing {required}");
+                }
+            } else { assert!(receipt.snapshot.pass_order.iter().any(|p| p == "TAA")); }
+            assert!(!receipt.receipts.is_empty(), "must record and submit real AA work");
+            fixture.bridge.wait_submits_done(10_000_000_000).unwrap();
+            let mut bytes = vec![0; 16 * 16 * 4];
+            readback_buffer.read_bytes(0, &mut bytes).unwrap();
+            let pixel = &bytes[(8 * 16 + 8) * 4..][..4];
+            assert!(pixel[0] >= 250 && pixel[1] <= 3 && pixel[2] <= 3 && pixel[3] == 255,
+                "original AA constant red center, TGSR={use_tgsr} frame={frame_index} prev={history_resource}: {pixel:?}");
+        }
+    }
+}

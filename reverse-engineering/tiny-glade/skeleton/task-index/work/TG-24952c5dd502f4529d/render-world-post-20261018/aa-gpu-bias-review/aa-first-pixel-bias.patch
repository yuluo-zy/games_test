+            // Keep the later-frame check separate: it consumes real history.
+            let blue_matches = if use_tgsr && frame_index == 0 {
+                pixel[2] == 22
+            } else { pixel[2] <= 3 };
+            assert!(pixel[0] >= 250 && pixel[1] <= 3 && blue_matches && pixel[3] == 255,

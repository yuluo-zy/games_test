@@ -1068,7 +1068,15 @@
             let mut bytes = vec![0; 16 * 16 * 4];
             readback_buffer.read_bytes(0, &mut bytes).unwrap();
             let pixel = &bytes[(8 * 16 + 8) * 4..][..4];

+    /// not establish a caller-supplied f64 argument.
+    pub fn cottage(native_u32_0c: u32, first: Vec3, second: Vec3, tail: [f32; 2]) -> Self {
+        Self::gothic(native_u32_0c, first, second, [tail[0], tail[1], 1.0, -50.0])

-enum InitialAdaptivePhase {
+enum AdaptivePhase {
     Initial,
+    Waiting { interval: Duration, deadline: Instant },
+    OutOfMemory,
+    Probing { interval: Duration, deadline: Instant },
 }
 
 impl AdaptiveRenderState {
-    /// B @0x1405a272e..2795: +0x28 = !CliArgs.ignore_vram_budget,

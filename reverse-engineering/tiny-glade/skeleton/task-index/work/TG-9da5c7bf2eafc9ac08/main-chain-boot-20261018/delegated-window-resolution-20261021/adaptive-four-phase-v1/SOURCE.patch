+    /// 原 render 的 OOM 重编译只写 tag=2，后续主循环不自动提升这个变体。
+    pub fn mark_out_of_memory(&mut self) {
+        self.phase = AdaptivePhase::OutOfMemory;
+    }
+
+    /// 原零尺寸门之后调用；预算刷新和交换链/资源失效由同一真实宿主负责。
+    pub fn update_frame_resolution(
+        &mut self,
+        frame: &mut FrameRenderConfig,
+        video: &VideoSettings,
+        maximum_scale: f32,
+    ) {
+        self.update_with_clock(frame, video, maximum_scale, Instant::now);
+    }
+
+    fn update_with_clock(
+        &mut self,
+        frame: &mut FrameRenderConfig,
+        video: &VideoSettings,
+        maximum_scale: f32,
+        mut now: impl FnMut() -> Instant,
+    ) {
+        let phase = if frame.world_resolution_scale > maximum_scale {
+            // 原 dce72 先写缩放；后续 Duration/Instant 溢出不能回滚此已完成写入。
+            log::info!("Driver VRAM budget low: reducing resolution scale from {} to {}",
+                frame.world_resolution_scale, maximum_scale);
+            frame.world_resolution_scale = maximum_scale;
+            match self.phase {
+                AdaptivePhase::Initial => {
+                    let interval = Duration::from_millis(250);
+                    AdaptivePhase::Waiting { interval, deadline: now() + interval }
+                }
+                AdaptivePhase::Waiting { interval, .. } => {
+                    AdaptivePhase::Waiting { interval, deadline: now() + interval }
+                }
+                AdaptivePhase::OutOfMemory => AdaptivePhase::OutOfMemory,
+                AdaptivePhase::Probing { interval, .. } => {
+                    let interval = interval * 2;
+                    AdaptivePhase::Waiting { interval, deadline: now() + interval }
+                }
+            }
+        } else {
+            // 原 dcec0 在四态跳表前读取时钟，即使 Initial/OutOfMemory 不用该值。
+            let now = now();
+            match self.phase {
+                AdaptivePhase::Waiting { interval, deadline }
+                    if now >= deadline && maximum_scale >= video.world_resolution_scale.unwrap_or(1.0) =>
+                {
+                    let requested = video.world_resolution_scale.unwrap_or(1.0);
+                    log::info!("Restoring resolution scale from {} to {}",
+                        frame.world_resolution_scale, requested);
+                    // 原 dd17d 先写回请求值，再做 interval 翻倍和 Instant::add。
+                    frame.world_resolution_scale = requested;
+                    let interval = interval * 2;
+                    AdaptivePhase::Probing {
+                        interval,
+                        deadline: now + interval.max(Duration::from_secs(2)),
+                    }
+                }
+                AdaptivePhase::Probing { deadline, .. } if now >= deadline => AdaptivePhase::Initial,
+                phase => phase,
+            }
+        };
+        frame.tgsr_resolution_scale = if video.upscaling_mode == UpscalingMode::Tgsr {
+            video.upscaling_preset.tgsr_resolution_scale()
+        } else { 1.0 };
+        let scaled = frame.extent_0.map(|axis| axis as f32 * frame.world_resolution_scale);
+        // 原 dd32b 在提交下一自适应状态前，已发布第一份 extent_8。
+        frame.extent_8 = scaled.map(|axis| (axis as u32).clamp(32, 10_912));
+        self.phase = phase;
+        // 原 1429e9600=31.0，1429e9610=~31：向上对齐32，不是对齐2。
+        // 饱和 as u32 保留 NaN/负值/无穷的原转换语义；乘法、加法不得合并为 FMA。
+        frame.extent_10 = scaled.map(|axis| {
+            let scaled = axis * frame.tgsr_resolution_scale;
+            (((scaled + 31.0) as u32) & !31).clamp(32, 10_912)
+        });
+        // 原 dd6a3/6ac 的最终提交顺序为 extent_10、extent_8。
+        frame.extent_8 = scaled.map(|axis| (axis as u32).clamp(32, 10_912));
+    }
+}

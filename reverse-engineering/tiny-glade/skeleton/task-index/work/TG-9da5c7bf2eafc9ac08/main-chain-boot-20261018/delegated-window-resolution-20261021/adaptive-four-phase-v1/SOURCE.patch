+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::render::render_config::UpscalingPreset;
+    use crate::resources::window::WindowSize;
+
+    fn frame(scale: f32) -> FrameRenderConfig {
+        let mut video = VideoSettings::default();
+        video.world_resolution_scale = Some(scale);
+        FrameRenderConfig::at_startup(WindowSize::new(514, 354), &video)
+    }
+
+    #[test]
+    fn native_quality_uses_unrounded_scaled_axes_then_aligns_inner_to_32() {
+        let mut state = AdaptiveRenderState::at_startup(true);
+        let mut frame = frame(0.75);
+        let mut video = VideoSettings::default();
+        video.world_resolution_scale = Some(0.75);
+        video.upscaling_mode = UpscalingMode::Tgsr;
+        video.upscaling_preset = UpscalingPreset::Quality;
+        state.update_frame_resolution(&mut frame, &video, f32::MAX);
+        assert_eq!(frame.extent_8, [385, 265]);
+        assert_eq!(frame.extent_10, [288, 192]);
+        assert_eq!(state.native_tag(), 0);
+    }
+
+    #[test]
+    fn four_native_phases_preserve_delay_reset_probe_backoff_and_expiry() {
+        let base = Instant::now();
+        let video = VideoSettings::default();
+        let mut frame = frame(1.0);
+        let mut state = AdaptiveRenderState::at_startup(false);
+        state.update_with_clock(&mut frame, &video, 0.8, || base);
+        assert_eq!(state.phase, AdaptivePhase::Waiting {
+            interval: Duration::from_millis(250), deadline: base + Duration::from_millis(250) });
+        let later = base + Duration::from_millis(100);
+        state.update_with_clock(&mut frame, &video, 0.7, || later);
+        assert_eq!(state.phase, AdaptivePhase::Waiting {
+            interval: Duration::from_millis(250), deadline: later + Duration::from_millis(250) });
+        let deadline = later + Duration::from_millis(250);
+        state.update_with_clock(&mut frame, &video, 1.0, || deadline);
+        assert_eq!(frame.world_resolution_scale, 1.0);
+        assert_eq!(state.phase, AdaptivePhase::Probing {
+            interval: Duration::from_millis(500), deadline: deadline + Duration::from_secs(2) });
+        state.update_with_clock(&mut frame, &video, 0.9, || deadline);
+        assert_eq!(state.phase, AdaptivePhase::Waiting {
+            interval: Duration::from_secs(1), deadline: deadline + Duration::from_secs(1) });
+        let restored = deadline + Duration::from_secs(1);
+        state.update_with_clock(&mut frame, &video, 1.0, || restored);
+        assert_eq!(state.phase, AdaptivePhase::Probing {
+            interval: Duration::from_secs(2), deadline: restored + Duration::from_secs(2) });
+        state.update_with_clock(&mut frame, &video, 1.0, || restored + Duration::from_secs(2));
+        assert_eq!(state.native_tag(), 0);
+    }
+
+    #[test]
+    fn waiting_requires_deadline_and_full_requested_budget_before_recovery() {
+        let base = Instant::now();
+        let video = VideoSettings::default();
+        let mut frame = frame(0.5);
+        let mut state = AdaptiveRenderState::at_startup(false);
+        state.phase = AdaptivePhase::Waiting { interval: Duration::from_secs(1), deadline: base };
+        state.update_with_clock(&mut frame, &video, 0.9, || base);
+        assert_eq!(frame.world_resolution_scale, 0.5);
+        assert_eq!(state.native_tag(), 1);
+        state.update_with_clock(&mut frame, &video, 1.0, || base - Duration::from_nanos(1));
+        assert_eq!(state.native_tag(), 1);
+        state.update_with_clock(&mut frame, &video, 1.0, || base);
+        assert_eq!(state.native_tag(), 3);
+    }
+
+    #[test]
+    fn out_of_memory_is_sticky_and_forced_decrease_does_not_read_clock() {
+        let mut frame = frame(1.0);
+        let mut state = AdaptiveRenderState::at_startup(false);
+        state.mark_out_of_memory();
+        state.update_with_clock(&mut frame, &VideoSettings::default(), 0.5, || panic!("tag2不读时钟"));
+        assert_eq!(frame.world_resolution_scale, 0.5);
+        assert_eq!(state.native_tag(), 2);
+        let mut reads = 0;
+        state.update_with_clock(&mut frame, &VideoSettings::default(), f32::MAX, || {
+            reads += 1; Instant::now()
+        });
+        assert_eq!(reads, 1);
+        assert_eq!(frame.world_resolution_scale, 0.5);
+        assert_eq!(state.native_tag(), 2);
+    }
+
+    #[test]
+    fn native_initial_does_not_synthesize_a_runtime_video_scale_setter() {
+        let mut frame = frame(1.0);
+        let mut video = VideoSettings::default();
+        video.world_resolution_scale = Some(0.5);
+        let mut state = AdaptiveRenderState::at_startup(true);
+        state.update_frame_resolution(&mut frame, &video, f32::MAX);
+        assert_eq!(frame.world_resolution_scale, 1.0);
+        assert_eq!(frame.extent_8, [514, 354]);
+        assert_eq!(frame.extent_10, [544, 384]);
+    }
+
+    #[test]
+    fn native_saturating_float_casts_and_clamps_preserve_nonfinite_inputs() {
+        for (scale, expected) in [(f32::NAN, [32, 32]), (-1.0, [32, 32]),
+            (0.0, [32, 32]), (f32::INFINITY, [10_912, 10_912])]
+        {
+            let mut frame = frame(scale);
+            let mut state = AdaptiveRenderState::at_startup(true);
+            state.mark_out_of_memory();
+            state.update_frame_resolution(&mut frame, &VideoSettings::default(), f32::NAN);
+            assert_eq!(frame.extent_8, expected);
+            assert_eq!(frame.extent_10, expected);
+        }
+    }
+
+    #[test]
+    fn duration_overflow_keeps_earlier_scale_write_and_old_uncommitted_phase() {
+        let now = Instant::now();
+        let phase = AdaptivePhase::Probing { interval: Duration::MAX, deadline: now };
+        let mut state = AdaptiveRenderState { enabled: true, phase };
+        let mut frame = frame(1.0);
+        let old = frame;
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            state.update_with_clock(&mut frame, &VideoSettings::default(), 0.5, || now);
+        }));
+        assert!(result.is_err());
+        assert_eq!(frame.world_resolution_scale, 0.5);
+        assert_eq!(frame.extent_8, old.extent_8);
+        assert_eq!(frame.extent_10, old.extent_10);
+        assert_eq!(state.phase, phase);
+    }
+}

+    #[test]
+    fn original_gauss_quoted_formats_resolve_both_shipped_artifact_keys() {
+        use rhapsody::shader_pipeline::{
+            pipeline_desc::ComputePipelineDesc, shader_defines::ShaderDefines,
+        };
+        for (source, expected) in [
+            (
+                GaussBlur {
+                    fmt: "rgba32f",
+                    vec4: true,
+                },
+                "compiled-shaders/_gauss_blur.cs.hlsl_cs_main_b9dd0465835cd591.bin",
+            ),
+            (
+                GaussBlur {
+                    fmt: "r16",
+                    vec4: false,
+                },
+                "compiled-shaders/_gauss_blur.cs.hlsl_cs_main_dc5fd7e4b9bf9935.bin",
+            ),
+        ] {
+            let desc = ComputePipelineDesc {
+                source_path: "/gauss_blur.cs.hlsl".into(),
+                entry_point: "cs_main".into(),
+                defines: ShaderDefines(source.pipeline_defines()),
+            };
+            assert_eq!(
+                desc.compiled_file_path(),
+                std::path::PathBuf::from(expected)
+            );
+        }
     }

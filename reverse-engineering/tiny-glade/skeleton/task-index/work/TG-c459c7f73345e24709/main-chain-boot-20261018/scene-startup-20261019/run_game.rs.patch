+#[derive(Debug)]
+struct GameplayPreparationCancelled;
+
+impl std::fmt::Display for GameplayPreparationCancelled {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("gameplay preparation cancelled")
+    }
+}

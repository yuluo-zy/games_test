+    check::<SemiTransparent>();
+    check::<FlatLighting>();
+    check::<DashedLineLength>();
+    check::<BackgroundTerrain>();
+    check::<DontReceiveContactShadows>();
+    check::<OverwriteRoughness>();
+    check::<TreeAnimation>();

+    /// Same actual App tables/heap/dynamic constants and shader handles, with
+    /// one current VulkanGraphSession local to the background render thread.
+    /// No new asset owner, resource backend, allocator or shader heap is built.
+    pub fn from_owners(owners: CoreRenderOwners) -> rhapsody::Result<Self> {
+        let device = owners.tables.buffers.graphics_device().clone();
+        let session = VulkanGraphSession::new(VulkanGraphBackend::new(device, AccessTable::original())?);

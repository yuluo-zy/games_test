+/// W54 diagnostic phases use the original capture as the real persistent
+/// reference producer. Explicit fixture phases are not a gameplay state machine
+/// shortcut, and no CPU image is substituted for the captured reference.
+#[test]
+fn original_shader_refactoring_replaces_the_full_frame_and_keeps_real_reference() {
+    use country_core::resources::shader_refactoring_state::ShaderRefactoringState;
+    let Some(mut fixture) = Fixture::new() else { return; };
+    for phase in 0..4 {
+        fixture.world.increment_change_tick();
+        let (disc, payload) = if phase == 0 { (0, 0) }
+            else if phase == 1 { (2, 3) } else { (3, 3) };
+        fixture.world.insert_resource(ShaderRefactoringState { disc, payload });
+        let device = fixture.device.clone();
+        let shaders = fixture.shaders.clone();
+        let ((output, source_id, result), built) = fixture.bridge.build_frame(|frame| {
+            tiny_glade::frame_setup::with_frame_resources(frame, &mut fixture.world, |frame, world| {
+                let texture = Arc::new(rhapsody::raw::texture::Texture::new(device.clone(),
+                    &rhapsody::raw::texture::TextureDesc::new_2d(16, 16, vk::Format::B10G11R11_UFLOAT_PACK32)
+                        .usage(vk::ImageUsageFlags::SAMPLED | vk::ImageUsageFlags::TRANSFER_DST))?);
+                let input = frame.import_native_texture(texture.clone(), 0)?;
+                frame.with_graph(|graph| {
+                    let device = device.clone();
+                    let mut pass = graph.add_pass("fixture original W54 input");
+                    pass.add_resource_access(input, 0x34, 0)?;
+                    pass.render_with_result_context(move |ctx| {
+                        unsafe { device.device.cmd_clear_color_image(
+                            vk::CommandBuffer::from_raw(ctx.command.handle()), texture.handle,
+                            vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                            &vk::ClearColorValue { float32: [if phase == 3 { 0.75 } else { 0.25 }, 0.5, 0.75, 1.0] },
+                            &[vk::ImageSubresourceRange::default().aspect_mask(vk::ImageAspectFlags::COLOR)
+                                .level_count(1).layer_count(1)]); }
+                        Ok(())
+                    }); Ok(())
+                })?;
+                let source = RgTexture { resource: input.raw(), desc: TextureDesc::new_2d([16, 16], 0x7a).sampled() };
+                let result = tiny_glade::world_postprocess::render_shader_refactoring(frame, world, source)?;
+                if phase < 2 { assert_eq!(result, source); }
+                else {
+                    assert_ne!(result.resource, source.resource, "must replace resource ID, not just desc bits");
+                    assert_eq!(result.desc, TextureDesc::new_2d([16, 16], 0x7a).storage().sampled());
+                }
+                if phase == 0 {
+                    assert_eq!(*world.resource::<ShaderRefactoringState>(), ShaderRefactoringState { disc: 0, payload: 0 });
+                    frame.with_graph(|graph| { assert!(!graph.declaration().resources.iter()
+                        .any(|r| r.name.contains("shader refactoring"))); Ok(()) })?;
+                } else if phase == 1 {
+                    assert_eq!(*world.resource::<ShaderRefactoringState>(), ShaderRefactoringState { disc: 2, payload: 4 });
+                } else {
+                    assert_eq!(*world.resource::<ShaderRefactoringState>(), ShaderRefactoringState { disc: 3, payload: 4 });
+                }
+                Ok((readback(frame, world, &shaders, &device, result)?, source.resource, result))
+            })
+        }).unwrap();
+        fixture.bridge.shader_backend().prewarm(Duration::from_secs(30)).unwrap();
+        let receipt = fixture.bridge.execute_built(built).unwrap();
+        let count = |name: &str| receipt.snapshot.pass_order.iter().filter(|p| p.as_str() == name).count();
+        assert_eq!(count("Shader refactoring capture"), usize::from(phase != 0));
+        assert_eq!(count("Shader refactoring compare"), usize::from(phase >= 2));
+        fixture.bridge.wait_submits_done(10_000_000_000).unwrap();
+        let mut bytes = vec![0; 16 * 16 * 4]; output.read_bytes(0, &mut bytes).unwrap();
+        let pixel = &bytes[(8 * 16 + 8) * 4..][..4];
+        if phase >= 2 {
+            // Exact original compare: reference RGB * .08 * (0,1,1)
+            // plus red1 iff any absolute difference exceeds1e-5. Original
+            // packed storage rounds G.04/B.06, then resolve applies sRGB.
+            let expected = [if phase == 3 { 255i16 } else { 0 }, 56, 69, 255];
+            for c in 0..4 { assert!((i16::from(pixel[c]) - expected[c]).abs() <= 1,
+                "phase={phase} source={source_id} result={} pixel={pixel:?} expected={expected:?}", result.resource); }
+        }
+    }
+}

+/// 原调用点的几何参数分组；caller 给定端点、方向与有序 locator ID 不重新猜测。
+struct StairAssemblyInput<'a> {
+    nodes: [(StairNodeAnchor, u8); 2],
+    points: [&'a StairPoint; 2],

+        ).unwrap(), no_padding(), [Vec2::X; 2], [Vec2::ZERO, Vec2::X],
+            StairAssemblyOverrides { tangents: Some(Vec::new()), ..no_stair_overrides() },
+            &Default::default());
+    }

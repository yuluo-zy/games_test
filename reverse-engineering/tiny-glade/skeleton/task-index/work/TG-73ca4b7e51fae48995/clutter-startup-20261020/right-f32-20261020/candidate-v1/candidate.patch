+            points.as_slice(), 0..=0,
+        ).remap(|index, point| {
+            assert_ne!(index, 2, "late remap failure");
+            *point
+        });
+        assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            slice.extend_right(10.0);
+        })).is_err());
+        assert_eq!(slice.end(), CurveInternalCoord { segment: 0, t: 1.0 });
+    }

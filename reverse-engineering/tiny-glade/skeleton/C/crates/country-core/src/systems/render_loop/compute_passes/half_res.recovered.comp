#version 450
#extension GL_EXT_samplerless_texture_functions : require
// C country-core 原 SPIR-V 的语义 GLSL 恢复；不是作者源码，也未编译/GPU 验收。
// payload SHA256 2a962aef4c657065c834d9f475fa22c2cc4977ab64c06b05cab44b202672e4b8
// 原模块的七个绑定、所有 ViewConstants 字段 offset/type 均保留。
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=2, binding=0, std140) uniform FrameCounter_natural {
    layout(offset=0) uint index;
} frame_counter;
layout(set=0, binding=1) uniform utexture2D stencil_tex;
layout(set=0, binding=2) uniform texture2D depth_input_tex;
layout(set=0, binding=3) uniform utexture2D gbuffer_input_tex;
layout(set=0, binding=4, r32f) uniform image2D depth_output_tex;
layout(set=0, binding=5, rgba8_snorm) uniform image2D normals_output_tex;
layout(set=4, binding=0, std140, row_major) uniform ViewConstants_natural {
    layout(offset=0) mat4 view_to_clip;
    layout(offset=64) mat4 clip_to_view;
    layout(offset=128) mat4 view_to_sample;
    layout(offset=192) mat4 sample_to_view;
    layout(offset=256) mat4 world_to_view; // 本入口唯一读取的矩阵
    layout(offset=320) mat4 view_to_world;
    layout(offset=384) mat4 world_to_sample;
    layout(offset=448) mat4 clip_to_prev_clip;
    layout(offset=512) mat4 prev_clip_to_clip;
    layout(offset=576) mat4 prev_view_to_prev_clip;
    layout(offset=640) mat4 prev_clip_to_prev_view;
    layout(offset=704) mat4 prev_world_to_prev_view;
    layout(offset=768) mat4 prev_view_to_prev_world;
    layout(offset=832) vec2 sample_offset_pixels;
    layout(offset=840) vec2 sample_offset_clip;
    layout(offset=848) vec2 prev_sample_offset_pixels;
    layout(offset=856) vec2 prev_sample_offset_clip;
    layout(offset=864) mat4 pad0;
    layout(offset=928) mat4 pad1;
    layout(offset=992) vec4 pad2;
    layout(offset=1008) float pad3;
    layout(offset=1012) float pad4;
    layout(offset=1016) float pad5;
    layout(offset=1020) float mip_bias;
} current_view;

void main() {
    const uvec2 offsets[4] = uvec2[4](uvec2(0,0), uvec2(0,1), uvec2(1,1), uvec2(1,0));
    uvec2 output_pixel = gl_GlobalInvocationID.xy;
    uvec2 offset = offsets[frame_counter.index & 3u];
    ivec2 source_pixel = ivec2(output_pixel * 2u + offset);
    // 原 OpImageFetch 未指定 Lod；当前入口只取二维单层资源。
    // GLSL texture texelFetch 的 level0 表达需匹配依赖实际 image view/mip，尚待 GPU 对照。
    float depth = texelFetch(depth_input_tex, source_pixel, 0).x;
    uint material_id = texelFetch(stencil_tex, source_pixel, 0).x & 7u;
    uint bits = floatBitsToUint(depth);
    bits = (material_id == 1u || material_id == 2u) ? (bits | 1u) : (bits & 0xfffffffeu);
    imageStore(depth_output_tex, ivec2(output_pixel), vec4(uintBitsToFloat(bits)));

    uint packed = texelFetch(gbuffer_input_tex, source_pixel, 0).x;
    float scale = uintBitsToFloat(998277249u);
    vec3 normal01 = vec3(float(packed & 255u) * scale,
                         float((packed >> 8u) & 255u) * scale,
                         float((packed >> 16u) & 255u) * scale);
    vec3 normal = normal01 * 2.0 - vec3(1.0);
    vec3 view_normal = normalize((vec4(normal, 0.0) * current_view.world_to_view).xyz);
    float alpha = (offset.x == 1u ? 1.0 : 0.5) * (offset.y == 1u ? 1.0 : -1.0);
    imageStore(normals_output_tex, ivec2(output_pixel), vec4(view_normal, alpha));
    // 原入口无 bounds guard/clamp；尾工作组/奇数边缘的访问语义依赖实际设备与视图，unknown。
}
